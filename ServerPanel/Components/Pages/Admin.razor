@* AdminPanel.razor *@
@page "/admin"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using ServerPanel.Contracts
@attribute [Authorize]
@using ServerPanel.Models
@inject ICs2ServerService Cs2ServerService
@inject IPlayerService PlayerService
@inject IServerQueryService ServerQueryService

<div class="wrap">

    <div class="top">
        <div class="top-icon"><i class="ti ti-shield-half"></i></div>
        <div>
            <p class="top-title">Panel de administración</p>
            <p class="top-sub">Gestión de jugadores y servidor CS2</p>
        </div>
    </div>

    @* ── Tabs ── *@
    <div class="tabs">
        <button type="button" class="tab @(ActiveSection == "map" ? "active-cyan" : "")" @onclick="@(() => SetTab("map"))">
            <i class="ti ti-map"></i>
            <span class="tab-label">Mapa</span>
            <span class="tab-desc">Cambiar mapa</span>
        </button>
        <button type="button" class="tab @(ActiveSection == "console" ? "active-amber" : "")" @onclick="@(() => SetTab("console"))">
            <i class="ti ti-terminal-2"></i>
            <span class="tab-label">Consola</span>
            <span class="tab-desc">Ejecutar comando</span>
        </button>
        <button type="button" class="tab @(ActiveSection == "perms" ? "active-purple" : "")" @onclick="@(() => SetTab("perms"))">
            <i class="ti ti-shield-check"></i>
            <span class="tab-label">Permisos</span>
            <span class="tab-desc">Asignar clase a jugador</span>
        </button>
    </div>

    @* ── Permisos ── *@
    @if (ActiveSection == "perms")
    {
        <div class="card card-anim">
            <div class="card-top">
                <div class="cicon cicon-purple"><i class="ti ti-shield-check"></i></div>
                <div>
                    <p class="card-title">Permisos</p>
                    <p class="card-sub">Ver, asignar y quitar flags de administrador</p>
                </div>
            </div>
            <div class="divider"></div>

            <div class="sub-tabs">
                <button type="button" class="sub-tab @(PermSub == "get" ? "sub-active-purple" : "")" @onclick="@(() => PermSub = "get")">
                    <i class="ti ti-eye"></i> Ver permisos
                </button>
                <button type="button" class="sub-tab @(PermSub == "set" ? "sub-active-purple" : "")" @onclick="@(() => PermSub = "set")">
                    <i class="ti ti-shield-check"></i> Asignar
                </button>
                <button type="button" class="sub-tab @(PermSub == "remove" ? "sub-active-red" : "")" @onclick="@(() => PermSub = "remove")">
                    <i class="ti ti-shield-x"></i> Quitar
                </button>
            </div>

            @* ── Ver ── *@
            @if (PermSub == "get")
            {
                <div class="field">
                    <p class="lbl"><i class="ti ti-user"></i> Nombre o SteamID</p>
                    <input class="inp" @bind="SharedSteamId" placeholder="Nombre ingame o 76561198XXXXXXXXX..." />
                </div>
                <div class="field">
                    <p class="lbl"><i class="ti ti-shield"></i> Flags activos</p>
                    <div class="perm-grid">
                        @foreach (var p in PermOptions)
                        {
                            <div class="popt @(LoadedEntry != null && LoadedEntry.Flags.Contains(p.Value) ? "sel" : "") popt-ro" title="@p.Desc">
                                <i class="ti @p.Icon"></i>
                                <div>
                                    <p class="popt-name">@p.Label</p>
                                    <p class="popt-desc">@p.Value</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="footer">
                    <button type="button" class="btn btn-purple" @onclick="HandleGetPerms">
                        <i class="ti ti-search"></i> Cargar
                    </button>
                </div>
            }

            @* ── Asignar ── *@
            @if (PermSub == "set")
            {
                <div class="row2">
                    <div class="field">
                        <p class="lbl"><i class="ti ti-user"></i> Nombre ingame</p>
                        <input class="inp" @bind="PermPlayerName" placeholder="Nombre exacto..." />
                    </div>
                    <div class="field">
                        <p class="lbl"><i class="ti ti-id"></i> SteamID</p>
                        <input class="inp" @bind="SharedSteamId" placeholder="76561198XXXXXXXXX..." />
                    </div>
                </div>
                <div class="field">
                    <p class="lbl"><i class="ti ti-shield-check"></i> Flags a asignar</p>
                    <div class="perm-grid">
                        @foreach (var p in PermOptions)
                        {
                            <button type="button" class="popt @(SelectedPerms.Contains(p.Value) ? "sel" : "")" @onclick="@(() => TogglePerm(p.Value))" title="@p.Desc">
                                <i class="ti @p.Icon"></i>
                                <div>
                                    <p class="popt-name">@p.Label</p>
                                    <p class="popt-desc">@p.Value</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>
                @if (SelectedPerms.Count > 0)
                {
                    <div class="perm-preview">
                        <span class="perm-preview-lbl"><i class="ti ti-tags"></i> Flags seleccionados</span>
                        <div class="perm-tags">
                            @foreach (var v in SelectedPerms)
                            {
                                <span class="perm-tag">@v <button type="button" @onclick="@(() => SelectedPerms.Remove(v))"><i class="ti ti-x"></i></button></span>
                            }
                        </div>
                    </div>
                }
                <div class="footer">
                    <button type="button" class="btn btn-ghost" @onclick="@(() => SelectedPerms.Clear())">
                        <i class="ti ti-trash"></i> Limpiar
                    </button>
                    <button type="button" class="btn btn-purple" @onclick="HandleSetPerms">
                        <i class="ti ti-shield-check"></i> Asignar
                    </button>
                </div>
            }

            @* ── Quitar ── *@
            @if (PermSub == "remove")
            {
                <div class="field">
                    <p class="lbl"><i class="ti ti-user"></i> Nombre o SteamID</p>
                    <input class="inp" @bind="SharedSteamId" placeholder="Nombre ingame o 76561198XXXXXXXXX..." />
                </div>
                <div class="field">
                    <p class="lbl"><i class="ti ti-shield-x"></i> Flag a quitar</p>
                    <div class="perm-grid">
                        @foreach (var p in PermOptions)
                        {
                            var userHas = LoadedEntry?.Flags.Contains(p.Value) ?? true;
                            <button type="button"
                                    class="popt @(RemoveFlag == p.Value ? "sel-red" : "") @(!userHas ? "popt-dim" : "")"
                                    @onclick="@(() => RemoveFlag = p.Value)"
                                    title="@p.Desc"
                                    disabled="@(!userHas)">
                                <i class="ti @p.Icon"></i>
                                <div>
                                    <p class="popt-name">@p.Label</p>
                                    <p class="popt-desc">@p.Value</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>
                <div class="footer">
                    <button type="button" class="btn btn-red" @onclick="HandleRemovePerm"
                            disabled="@(string.IsNullOrWhiteSpace(RemoveFlag) || string.IsNullOrWhiteSpace(SharedSteamId))">
                        <i class="ti ti-shield-x"></i> Quitar permiso
                    </button>
                </div>
            }
        </div>
    }

    @* ── Consola ── *@
    @if (ActiveSection == "console")
    {
        <div class="card card-anim">
            <div class="card-top">
                <div class="cicon cicon-amber"><i class="ti ti-terminal-2"></i></div>
                <div>
                    <p class="card-title">Consola del servidor</p>
                    <p class="card-sub">Ejecuta comandos directamente en el servidor</p>
                </div>
            </div>
            <div class="divider"></div>
            <div class="field">
                <p class="lbl"><i class="ti ti-terminal-2"></i> Comando</p>
                <div class="cmd-wrap">
                    <span class="cmd-pfx">$</span>
                    <input class="inp cmd-inp" @bind="ConsoleCommand" placeholder="sv_cheats 1, mp_restartgame 1..." />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(ConsoleOutput))
            {
                <div class="console-out">
                    <div class="console-bar">
                        <div class="console-dot" style="background:#ef4444"></div>
                        <div class="console-dot" style="background:#fbbf24"></div>
                        <div class="console-dot" style="background:#4ade80"></div>
                    </div>
                    <pre class="console-pre">@ConsoleOutput</pre>
                </div>
            }
            <div class="footer">
                <button type="button" class="btn btn-amber" @onclick="HandleConsole">
                    <i class="ti ti-player-play"></i> Ejecutar
                </button>
            </div>
        </div>
    }

    @* ── Mapa ── *@
    @if (ActiveSection == "map")
    {
        <div class="card card-anim">

            @* Header compacto *@
            <div class="map-hdr">
                <div class="map-hdr-left">
                    <div class="cicon cicon-cyan"><i class="ti ti-map"></i></div>
                    <div>
                        <p class="card-title">Cambiar mapa</p>
                        <p class="card-sub">Arrastra un mapa al área de abajo para cargarlo</p>
                    </div>
                </div>
                <div class="map-hdr-right">
                    @if (CurrentMap is not null)
                    {
                        <div class="map-current">
                            <i class="ti ti-map-pin" style="color:#22d3ee;font-size:13px"></i>
                            <span class="map-current-lbl">En curso</span>
                            <span class="map-current-name">@CurrentMap</span>
                        </div>
                    }
                    <div class="map-search-wrap">
                        <i class="ti ti-search map-search-icon"></i>
                        <input class="inp map-search-inp" @bind="MapSearch" @bind:event="oninput" placeholder="Buscar mapa..." />
                    </div>
                    <button type="button" class="btn btn-ghost btn-sm" @onclick="LoadMaps" disabled="@MapLoading" title="Recargar">
                        @if (MapLoading)
                        {
                            <i class="ti ti-loader-2 spin"></i>
                        }
                        else
                        {
                            <i class="ti ti-refresh"></i>
                        }
                    </button>
                </div>
            </div>

            <div class="divider" style="margin: 0.75rem 0"></div>

            @if (MapError is not null)
            {
                <p class="map-error"><i class="ti ti-alert-circle"></i> @MapError</p>
            }

            @* Grid *@
            @if (MapLoading)
            {
                <div class="map-loading">
                    <div class="map-spinner"></div>
                    <p>Cargando mapas de la colección...</p>
                </div>
            }
            else if (WorkshopMaps.Count > 0)
            {
                <div class="map-grid">
                    @foreach (var map in WorkshopMaps.Where(m => string.IsNullOrEmpty(MapSearch) || m.Name.Contains(MapSearch, StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="map-card @(DraggedMap?.Id == map.Id ? "map-dragging" : "")"
                             draggable="true"
                             @ondragstart="@(() => DraggedMap = map)">
                            <div class="map-img-wrap">
                                @if (!string.IsNullOrEmpty(map.PreviewUrl))
                                {
                                    <img class="map-img" src="@map.PreviewUrl" alt="@map.Name" loading="lazy" />
                                }
                                else
                                {
                                    <div class="map-img map-img-placeholder"><i class="ti ti-map-2"></i></div>
                                }
                            </div>
                            <p class="map-name">@map.Name</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="map-empty">
                    <i class="ti ti-map-off"></i>
                    <p>Pulsa el botón de recarga para cargar los mapas</p>
                </div>
            }

            @* Drop zone *@
            <div class="map-drop @(DropActive ? "drop-active" : "") @(DraggedMap != null ? "drop-ready" : "")"
                 @ondragover:preventDefault="true"
                 @ondragenter="@(() => DropActive = true)"
                 @ondragleave="@(() => DropActive = false)"
                 @ondrop="HandleMapDrop">
                @if (DropActive && DraggedMap != null)
                {
                    <i class="ti ti-player-play"></i>
                    <span>Soltar para cargar <strong>@DraggedMap.Name</strong></span>
                }
                else
                {
                    <i class="ti ti-map-pin"></i>
                    <span>Arrastra un mapa aquí</span>
                }
            </div>

        </div>
    }

    @* ── Toast ── *@
    @if (ToastVisible)
    {
        <div class="toast-fixed @(ToastOk ? "tok" : "tow")">
            <i class="ti @(ToastOk ? "ti-circle-check" : "ti-circle-x")"></i>
            @ToastMessage
        </div>
    }

</div>

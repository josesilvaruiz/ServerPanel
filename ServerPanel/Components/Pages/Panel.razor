@page "/panel"
@rendermode InteractiveServer
@using ServerPanel.Contracts
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ICs2ServerService Cs2

<PageTitle>ServerPanel</PageTitle>

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-xl-6 col-lg-8">

            <div class="card border-0 shadow-lg">

                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">

                    <h3 class="mb-0">
                        🎮 Servidor CS2
                    </h3>

                    @if (IsRunning)
                    {
                        <span class="badge bg-success fs-6">
                            Online
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6">
                            Offline
                        </span>
                    }

                </div>

                <div class="card-body p-4">

                    @if (Loading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                        </div>
                    }
                    else
                    {
                        <div class="alert @(IsRunning ? "alert-success" : "alert-danger")">
                            <strong>Estado:</strong>
                            @(IsRunning ? " Servidor operativo" : " Servidor detenido")
                        </div>

                        <div class="row g-3">

                            <div class="col-md-6">
                                <button class="btn btn-success w-100"
                                        @onclick="StartServer"
                                        disabled="@ActionRunning">
                                    🚀 Iniciar
                                </button>
                            </div>

                            <div class="col-md-6">
                                <button class="btn btn-warning w-100"
                                        @onclick="RestartServer"
                                        disabled="@ActionRunning">
                                    🔄 Reiniciar
                                </button>
                            </div>

                            <div class="col-md-6">
                                <button class="btn btn-danger w-100"
                                        @onclick="StopServer"
                                        disabled="@ActionRunning">
                                    ⛔ Detener
                                </button>
                            </div>

                            <div class="col-md-6">
                                <button class="btn btn-secondary w-100"
                                        @onclick="RefreshStatus"
                                        disabled="@ActionRunning">
                                    📡 Actualizar
                                </button>
                            </div>

                        </div>

                        @if (!string.IsNullOrWhiteSpace(StatusMessage))
                        {
                            <div class="alert alert-info mt-4 mb-0">
                                @StatusMessage
                            </div>
                        }
                    }

                </div>

            </div>

        </div>

    </div>

</div>

@code {

    private bool Loading = true;
    private bool ActionRunning = false;

    private bool IsRunning = false;

    private string StatusMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatus();
    }

    private async Task RefreshStatus()
    {
        try
        {
            Loading = true;

            IsRunning = await Cs2.IsRunningAsync();

            StatusMessage = $"Última actualización: {DateTime.Now:HH:mm:ss}";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task StartServer()
    {
        try
        {
            ActionRunning = true;

            await Cs2.StartAsync();

            await Task.Delay(3000);

            await RefreshStatus();

            StatusMessage = "Servidor iniciado correctamente.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }
        finally
        {
            ActionRunning = false;
        }
    }

    private async Task StopServer()
    {
        try
        {
            ActionRunning = true;

            await Cs2.StopAsync();

            await Task.Delay(3000);

            await RefreshStatus();

            StatusMessage = "Servidor detenido correctamente.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }
        finally
        {
            ActionRunning = false;
        }
    }

    private async Task RestartServer()
    {
        try
        {
            ActionRunning = true;

            await Cs2.RestartAsync();

            await Task.Delay(5000);

            await RefreshStatus();

            StatusMessage = "Servidor reiniciado correctamente.";
        }
        catch (Exception ex)
        {
            StatusMessage = ex.Message;
        }
        finally
        {
            ActionRunning = false;
        }
    }

}
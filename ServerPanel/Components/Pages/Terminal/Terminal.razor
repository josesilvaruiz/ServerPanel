@namespace ServerPanel.Components.Pages
@page "/terminal"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IStringLocalizer<SharedResource> L

<div class="term-mob-overlay @(_mobSidebarOpen ? "mob-open" : "")" @onclick="() => _mobSidebarOpen = false"></div>

<div class="term-desktop">

    <div class="term-desktop-bar">
        <div class="term-desktop-bar-left">
            <button type="button" class="term-sidebar-toggle" title="Panel de comandos"
                    @onclick="ToggleSidebar">
                <i class="ti @(SidebarOpen ? "ti-layout-sidebar-left-collapse" : "ti-layout-sidebar")"></i>
            </button>
            <i class="ti ti-terminal-2" style="color:#4ade80;font-size:16px"></i>
            <span class="term-desktop-title">SSH Terminal</span>
            <span class="term-desktop-host">@HostLabel</span>
        </div>
        <div class="term-desktop-bar-right">
            <button type="button" class="term-new-btn" @onclick="OpenNewTerminal">
                <i class="ti ti-plus"></i> Nueva terminal
            </button>
        </div>
    </div>

    <div class="term-body">

    @* ── Sidebar ── *@
    @if (SidebarOpen || _mobSidebarOpen)
    {
        <div class="term-sidebar @(_mobSidebarOpen ? "mob-open" : "")" id="term-sidebar">
            <div class="term-sidebar-header">
                <i class="ti ti-bookmark" style="color:#4ade80"></i>
                <span>Comandos</span>
                <button type="button" class="term-sb-icon-btn" title="Nuevo grupo" @onclick='() => { ShowNewGroup = !ShowNewGroup; NewGroupShared = _sidebarTab == "shared"; }'>
                    <i class="ti ti-folder-plus"></i>
                </button>
            </div>

            <div class="term-sb-tabs">
                <button type="button" class="term-sb-tab @(_sidebarTab == "shared" ? "term-sb-tab-active" : "")"
                        @onclick='() => { _sidebarTab = "shared"; ShowNewGroup = false; }'>
                    <i class="ti ti-users"></i> Shared
                </button>
                <button type="button" class="term-sb-tab @(_sidebarTab == "personal" ? "term-sb-tab-active" : "")"
                        @onclick='() => { _sidebarTab = "personal"; ShowNewGroup = false; }'>
                    <i class="ti ti-user"></i> Personal
                </button>
            </div>

            @if (ShowNewGroup)
            {
                <div class="term-sb-newgroup">
                    <input class="term-sb-input" placeholder="Título del grupo..." @bind="NewGroupTitle" @onkeydown="HandleNewGroupKey" maxlength="40" autofocus />
                    <div class="term-sb-scope-toggle">
                        <button type="button" class="term-sb-scope-btn @(!NewGroupShared ? "term-sb-scope-active" : "")"
                                @onclick="() => NewGroupShared = false">
                            <i class="ti ti-user"></i> Solo yo
                        </button>
                        <button type="button" class="term-sb-scope-btn @(NewGroupShared ? "term-sb-scope-active term-sb-scope-shared" : "")"
                                @onclick="() => NewGroupShared = true">
                            <i class="ti ti-users"></i> Shared
                        </button>
                    </div>
                    <div class="term-sb-newgroup-actions">
                        <button type="button" class="term-sb-action-btn term-sb-ok" @onclick="AddGroup"><i class="ti ti-check"></i> Crear</button>
                        <button type="button" class="term-sb-action-btn" @onclick="() => { ShowNewGroup = false; NewGroupTitle = string.Empty; NewGroupShared = false; }"><i class="ti ti-x"></i></button>
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(_cmdGroupsError))
            {
                <div style="padding:8px;color:#f87171;font-size:11px">
                    <i class="ti ti-wifi-off"></i> Sin conexión BD
                    <button type="button" style="margin-left:6px;background:#1e3a2f;border:none;color:#4ade80;cursor:pointer;font-size:11px;padding:2px 6px;border-radius:4px" @onclick="async () => { await LoadCmdGroups(); StateHasChanged(); }">Reintentar</button>
                </div>
            }

            <div class="term-sb-groups">
                @foreach (var topic in TabGroupsByTopic)
                {
                    <div class="term-sb-topic">
                        <div class="term-sb-topic-header" @onclick="() => ToggleTopic(topic.Key)">
                            <i class="ti @(IsTopicExpanded(topic.Key) ? "ti-chevron-down" : "ti-chevron-right")" style="font-size:11px;color:#64748b"></i>
                            <span class="term-sb-topic-title">@topic.Key</span>
                            <span class="term-sb-topic-count">@topic.Count()</span>
                        </div>

                        @if (IsTopicExpanded(topic.Key))
                        {
                            @foreach (var grp in topic)
                            {
                                <div class="term-sb-group">
                                    <div class="term-sb-group-header" @onclick="() => grp.Expanded = !grp.Expanded">
                                        <i class="ti @(grp.Expanded ? "ti-folder-open" : "ti-folder")" style="color:@(grp.IsShared ? "#fbbf24" : "#4ade80");font-size:12px"></i>
                                        <span class="term-sb-group-title">@ExtractSubtitle(grp.Title)</span>
                                        <div class="term-sb-group-actions">
                                            @if (grp.Commands.Count > 0)
                                            {
                                                <button type="button" class="term-sb-icon-btn term-sb-run @(grp.IsRunning ? "term-sb-running" : "")"
                                                        title="Ejecutar todos" @onclick:stopPropagation="true"
                                                        @onclick="() => RunScript(grp)"
                                                        disabled="@grp.IsRunning">
                                                    <i class="ti @(grp.IsRunning ? "ti-loader-2" : "ti-player-play")"></i>
                                                </button>
                                            }
                                            <button type="button" class="term-sb-icon-btn" title="Añadir comando" @onclick:stopPropagation="true"
                                                    @onclick="() => { grp.ShowAdd = !grp.ShowAdd; grp.NewCmd = string.Empty; }">
                                                <i class="ti ti-plus"></i>
                                            </button>
                                            <button type="button" class="term-sb-icon-btn term-sb-del" title="Eliminar grupo" @onclick:stopPropagation="true"
                                                    @onclick="() => DeleteGroup(grp)">
                                                <i class="ti ti-trash"></i>
                                            </button>
                                        </div>
                                    </div>

                                    @if (grp.Expanded)
                                    {
                                        @if (grp.ShowAdd)
                                        {
                                            <div class="term-sb-addcmd">
                                                <textarea class="term-sb-input term-sb-textarea" placeholder="Comando o apunte..." @bind="grp.NewCmd" rows="2"></textarea>
                                                <div class="term-sb-newgroup-actions">
                                                    <button type="button" class="term-sb-action-btn term-sb-ok" @onclick="() => AddCmd(grp)"><i class="ti ti-check"></i></button>
                                                    <button type="button" class="term-sb-action-btn" @onclick="() => grp.ShowAdd = false"><i class="ti ti-x"></i></button>
                                                </div>
                                            </div>
                                        }

                                        @foreach (var item in grp.Commands)
                                        {
                                            <div class="term-sb-cmd-row">
                                                <button type="button" class="term-sb-cmd" title="@item.Text" @onclick="() => PasteCmd(item.Text)">
                                                    <span class="term-sb-cmd-text">@item.Text</span>
                                                </button>
                                                <button type="button" class="term-sb-icon-btn term-sb-del" title="Eliminar" @onclick="() => DeleteCmd(grp, item)">
                                                    <i class="ti ti-x"></i>
                                                </button>
                                            </div>
                                        }

                                        @if (grp.Commands.Count == 0 && !grp.ShowAdd)
                                        {
                                            <p class="term-sb-empty">Sin comandos</p>
                                        }
                                    }
                                </div>
                            }
                        }
                    </div>
                }

                @{ var tabEmpty = !TabGroups.Any(); }
                @if (tabEmpty && !ShowNewGroup)
                {
                    <div class="term-sb-hint">
                        <i class="ti ti-folder-plus"></i>
                        <p>@(_sidebarTab == "shared" ? "Sin grupos compartidos" : "Sin grupos personales")</p>
                    </div>
                }
            </div>
            <div class="term-sidebar-resize-handle" id="term-sidebar-resize"></div>
        </div>
    }

    @* ── Workspace ── *@
    <div class="term-workspace">

    @foreach (var session in Sessions)
    {
        <div id="win-@session.Id"
             class="term-window @(session.Minimized ? "term-window-minimized" : "") @(session.Maximized ? "term-window-maximized" : "")"
             style="left:@(session.Left)px;top:@(session.Top)px;width:@(session.Width)px;height:@(session.Height)px;z-index:@session.ZIndex"
             @onmousedown="() => BringToFront(session)">

            @* Title bar *@
            <div id="titlebar-@session.Id"
                 class="term-win-titlebar"
                 @ondblclick="() => ToggleMaximize(session)">
                <div class="term-win-dots">
                    <button class="term-win-dot term-dot-red" @onclick="() => CloseSession(session)" @onclick:stopPropagation="true" title="Cerrar"></button>
                    <button class="term-win-dot term-dot-yellow" @onclick="() => ToggleMinimize(session)" @onclick:stopPropagation="true" title="Minimizar"></button>
                    <button class="term-win-dot term-dot-green" @onclick="() => ToggleMaximize(session)" @onclick:stopPropagation="true" title="Maximizar"></button>
                </div>
                <span class="term-win-title">
                    <i class="ti ti-terminal-2"></i>
                    @session.UserAtHost
                </span>
                <div class="term-win-fs" title="Tamaño de fuente (@session.FontSize px)">
                    <span class="term-fs-label">A @session.FontSize px</span>
                    <input type="range" class="term-fs-slider" min="12" max="22" step="1"
                           value="@session.FontSize"
                           @oninput="e => { session.FontSize = int.Parse(e.Value!.ToString()!); SaveLayout(); }"
                           @onclick:stopPropagation="true" />
                </div>
                <button class="term-win-close" @onclick="() => CloseSession(session)" @onclick:stopPropagation="true" title="Cerrar terminal">
                    <i class="ti ti-x"></i>
                </button>
            </div>

            @* Help overlay *@
            @if (session.ShowHelp)
            {
                <div class="term-help-overlay" @onclick="() => session.ShowHelp = false">
                    <div class="term-help-panel" @onclick:stopPropagation="true">
                        <div class="term-help-header">
                            <span><i class="ti ti-book"></i> Referencia rápida</span>
                            <button type="button" class="term-btn" @onclick="() => session.ShowHelp = false"><i class="ti ti-x"></i></button>
                        </div>
                        <div class="term-help-grid">
                            @foreach (var cat in HelpCategories)
                            {
                                <div class="term-help-cat">
                                    <div class="term-help-cat-title"><i class="ti @cat.Icon"></i> @cat.Name</div>
                                    @foreach (var cmd in cat.Commands)
                                    {
                                        <button type="button" class="term-help-chip"
                                                @onclick="() => { session.CurrentCommand = cmd.Cmd; session.ShowHelp = false; }">
                                            <span class="term-help-code">@cmd.Cmd</span>
                                            <span class="term-help-desc">@cmd.Desc</span>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @* Content (hidden when minimized) *@
            @if (!session.Minimized)
            {
                <div class="term-win-toolbar">
                    <button type="button" class="term-btn" title="Referencia de comandos tmux y Linux" @onclick="() => session.ShowHelp = !session.ShowHelp">
                        <i class="ti ti-book"></i> Referencia
                    </button>
                    <button type="button" class="term-btn" title="Limpiar pantalla (Ctrl+L)" @onclick="() => ClearSession(session)">
                        <i class="ti ti-eraser"></i> Limpiar
                    </button>
                    <button type="button" class="term-btn @(session.Copied ? "term-btn-ok" : "")" title="Copiar todo el historial al portapapeles" @onclick="() => CopySession(session)">
                        <i class="ti @(session.Copied ? "ti-check" : "ti-copy")"></i> @(session.Copied ? "Copiado" : "Copiar")
                    </button>
                </div>

                <div id="out-@session.Id" class="term-win-output" style="font-size:@(session.FontSize)px">
                    @foreach (var entry in session.History)
                    {
                        <div class="term-entry">
                            <div class="term-cmd-line">
                                <span class="term-prompt">@entry.Prompt</span>
                                <span class="term-cmd-text">@entry.Command</span>
                            </div>
                            @if (entry.IsRunning)
                            {
                                <div class="term-running"><span class="term-spinner"></span> ejecutando...</div>
                            }
                            else if (!string.IsNullOrEmpty(entry.Output))
                            {
                                <pre class="term-out-pre @(entry.IsError ? "term-out-err" : "")">@entry.Output</pre>
                            }
                        </div>
                    }
                    @if (session.History.Count == 0)
                    {
                        <div class="term-welcome">
                            <i class="ti ti-terminal"></i>
                            <p>Terminal SSH lista. Escribe un comando.</p>
                            <p class="term-welcome-sub">
                                <span @onclick="@(() => session.CurrentCommand = "ls -la")">ls -la</span>
                                <span @onclick="@(() => session.CurrentCommand = "df -h")">df -h</span>
                                <span @onclick="@(() => session.CurrentCommand = "free -h")">free -h</span>
                                <span @onclick="@(() => session.CurrentCommand = "uptime")">uptime</span>
                            </p>
                        </div>
                    }
                </div>

                <div class="term-win-inputbar" style="font-size:@(session.FontSize)px">
                    <span class="term-prompt">@session.UserAtHost$&nbsp;</span>
                    <input id="inp-@session.Id"
                           class="term-input"
                           value="@session.CurrentCommand"
                           @oninput="e => session.CurrentCommand = e.Value?.ToString() ?? string.Empty"
                           @onkeydown="e => HandleKey(e, session)"
                           autocomplete="off" spellcheck="false"
                           placeholder="comando..."
                           disabled="@session.IsRunning" />
                    <button type="button" class="term-send-btn"
                            @onclick="() => SendCommand(session)"
                            disabled="@(session.IsRunning || string.IsNullOrWhiteSpace(session.CurrentCommand))">
                        <i class="ti ti-player-play"></i>
                    </button>
                </div>

                <div class="term-rh term-rh-nw" id="rh-nw-@session.Id"></div>
                <div class="term-rh term-rh-ne" id="rh-ne-@session.Id"></div>
                <div class="term-rh term-rh-sw" id="rh-sw-@session.Id"></div>
                <div class="term-rh term-rh-se" id="rh-se-@session.Id"></div>
            }
        </div>
    }

    @if (Sessions.Count == 0)
    {
        <div class="term-empty-desktop">
            <i class="ti ti-terminal-2"></i>
            <p>No hay terminales abiertas</p>
            <button type="button" class="term-new-btn" @onclick="OpenNewTerminal">
                <i class="ti ti-plus"></i> Abrir terminal
            </button>
        </div>
    }

    </div>@* /term-workspace *@
    </div>@* /term-body *@

</div>

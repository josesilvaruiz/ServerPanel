@* ReasonModal.razor: Modal reutilizable para pedir motivo de Kick/Ban *@
@if (Show)
{
    <div class="modal-backdrop show" @onclick="OnCancel"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content reason-modal-content">
                <div class="modal-header reason-modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="OnCancel" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <label for="reasonInput" class="form-label">Motivo:</label>
                    <input id="reasonInput" class="form-control" @bind="Reason" @bind:event="oninput" maxlength="120" autofocus />
                    @if (ShowDuration)
                    {
                        <label for="durationInput" class="form-label mt-3">Duración (minutos, 0 = permanente):</label>
                        <input id="durationInput" type="number" min="0" class="form-control" @bind="DurationMinutes" />
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="OnCancel">Cancelar</button>
                    <button class="btn btn-primary" @onclick="Confirm" disabled="@string.IsNullOrWhiteSpace(Reason)">Confirmar</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "Motivo requerido";
    [Parameter] public EventCallback<(string Reason, int Duration)> OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string Reason { get; set; } = string.Empty;
    [Parameter] public bool ShowDuration { get; set; } = false;
    [Parameter] public int DurationMinutes { get; set; } = 0;

    private async Task Confirm()
    {
        if (!string.IsNullOrWhiteSpace(Reason))
            await OnConfirm.InvokeAsync((Reason, DurationMinutes));
    }
}

<style>
.reason-modal-content {
    background: #111827;
    border: 1px solid #1e2a3a;
    border-radius: 14px;
    color: white;
    overflow: hidden;
}
.reason-modal-header {
    background: #0d1117;
    border-bottom: 1px solid #1e2a3a;
}
.form-label {
    color: #b6c2d6;
    font-weight: 600;
}
.form-control {
    background: #181c26;
    color: white;
    border: 1px solid #232b36;
    border-radius: 7px;
}
.form-control:focus {
    background: #232b36;
    color: white;
    border-color: #3b82f6;
    box-shadow: 0 0 0 2px #3b82f6;
}
</style>

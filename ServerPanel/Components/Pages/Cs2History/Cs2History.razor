@namespace ServerPanel.Components.Pages
@page "/cs2-history"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using ServerPanel.Data
@using ServerPanel.Models
@using ServerPanel.Services
@attribute [Authorize]
@inject ApplicationDbContext Db
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IJSRuntime JS
@inject ServerPanel.Contracts.IActiveServerService ActiveServer

<div class="wrap">

    <div class="top">
        <div class="top-icon"><i class="ti ti-brand-steam"></i></div>
        <div>
            <p class="top-title">Historial CS2</p>
            <p class="top-sub">Actividad del servidor de juego</p>
        </div>
        <button type="button" class="btn-global @(ShowGlobal ? "active" : "")" @onclick="ToggleGlobalAsync"
                title="Jugadores únicos y retención (histórico completo)">
            <i class="ti @(ShowGlobal ? "ti-arrow-left" : "ti-chart-dots-3")"></i>
            <span>@(ShowGlobal ? "Volver a actividad" : "Jugadores y retención")</span>
        </button>
        <button type="button" class="btn-refresh" @onclick="RefreshAsync" disabled="@(ShowGlobal ? GlobalLoading : Loading)">
            <i class="ti @((ShowGlobal ? GlobalLoading : Loading) ? "ti-loader-2 spin" : "ti-refresh")"></i>
        </button>
    </div>

    @if (ShowGlobal)
    {
        @* ── Vista global: jugadores únicos y retención (histórico completo de conexiones) ── *@
        @if (ActiveServer.Servers.Count > 1)
        {
            <div class="scope-row">
                <span class="kpi-section-lbl">Servidor</span>
                <div class="scope-chips">
                    <button type="button" class="scope-chip @(GlobalScope == ScopeAll ? "active" : "")"
                            @onclick="() => SetScopeAsync(ScopeAll)" disabled="@GlobalLoading">
                        <i class="ti ti-server-2"></i> Ambos
                    </button>
                    @foreach (var srv in ActiveServer.Servers)
                    {
                        var key = srv.Name;
                        <button type="button" class="scope-chip @(GlobalScope == key ? "active" : "")"
                                @onclick="() => SetScopeAsync(key)" disabled="@GlobalLoading">
                            @srv.Label
                        </button>
                    }
                </div>
            </div>
        }

        @if (GlobalLoading)
        {
            <div class="state-box">
                <div class="spinner"></div>
                <p>Calculando estadísticas...</p>
            </div>
        }
        else if (GlobalError is not null)
        {
            <div class="state-box state-error">
                <i class="ti ti-alert-circle"></i>
                <p>@GlobalError</p>
            </div>
        }
        else if (Global is null || Global.TotalUnique == 0)
        {
            <div class="state-box">
                <i class="ti ti-database-off"></i>
                <p>Sin conexiones registradas todavía para este alcance.</p>
            </div>
        }
        else
        {
            var gs = Global;
            <div class="kpi-section-lbl">
                Jugadores únicos · @ScopeLabel
                @if (gs.FirstEventUtc is { } since) { <span class="lbl-note">(datos desde @ToMadridDate(since))</span> }
            </div>
            <div class="kpi-grid kpi-grid-4">
                <div class="kpi-card">
                    <span class="kpi-icon ki-purple"><i class="ti ti-users-group"></i></span>
                    <div>
                        <p class="kpi-val">@gs.TotalUnique</p>
                        <p class="kpi-lbl">Únicos (total)</p>
                    </div>
                </div>
                <div class="kpi-card">
                    <span class="kpi-icon ki-cyan"><i class="ti ti-calendar-week"></i></span>
                    <div>
                        <p class="kpi-val">@gs.Unique7d <span class="kpi-sub">/ @gs.Unique30d</span></p>
                        <p class="kpi-lbl">Únicos 7 d / 30 d</p>
                    </div>
                </div>
                <div class="kpi-card">
                    <span class="kpi-icon ki-green"><i class="ti ti-user-plus"></i></span>
                    <div>
                        <p class="kpi-val">@gs.New7d <span class="kpi-sub">/ @gs.New30d</span></p>
                        <p class="kpi-lbl">Nuevos 7 d / 30 d</p>
                    </div>
                </div>
                <div class="kpi-card">
                    <span class="kpi-icon ki-amber"><i class="ti ti-repeat"></i></span>
                    <div>
                        <p class="kpi-val">@gs.Returning <span class="kpi-sub">@($"{gs.ReturningPct:0.#} %")</span></p>
                        <p class="kpi-lbl">Vuelven (≥ 2 días) · media @($"{gs.AvgActiveDays:0.#}") días</p>
                    </div>
                </div>
            </div>

            @if (GlobalScope == ScopeAll && gs.PerServer.Count > 0)
            {
                <div class="kpi-section-lbl" style="margin-top:.25rem">Por servidor</div>
                <div class="kpi-grid kpi-grid-4">
                    @foreach (var ps in gs.PerServer)
                    {
                        <div class="kpi-card">
                            <span class="kpi-icon ki-cyan"><i class="ti ti-server"></i></span>
                            <div>
                                <p class="kpi-val">@ps.UniquePlayers</p>
                                <p class="kpi-lbl">Únicos · @ServerLabel(ps.ServerKey)</p>
                            </div>
                        </div>
                    }
                    <div class="kpi-card">
                        <span class="kpi-icon ki-purple"><i class="ti ti-arrows-exchange"></i></span>
                        <div>
                            <p class="kpi-val">@gs.SharedAcrossServers</p>
                            <p class="kpi-lbl">Juegan en ambos</p>
                        </div>
                    </div>
                </div>
            }

            <div class="kpi-section-lbl" style="margin-top:.25rem">Retención · % que vuelve otro día tras su primera visita</div>
            <div class="kpi-grid kpi-grid-3">
                @foreach (var r in gs.Retention)
                {
                    var cls = r.Pct is null ? "" : r.Pct >= 40 ? "ki-green" : r.Pct >= 20 ? "ki-amber" : "ki-red";
                    <div class="kpi-card">
                        <span class="kpi-icon @cls"><i class="ti ti-rotate-clockwise"></i></span>
                        <div>
                            <p class="kpi-val">@(r.Pct is { } p ? $"{p:0.#} %" : "—")</p>
                            <p class="kpi-lbl">@(r.Days == 1 ? "Al día siguiente" : $"En ≤ {r.Days} días") · @r.Returned / @r.Eligible</p>
                        </div>
                    </div>
                }
            </div>

            <div class="kpi-section-lbl" style="margin-top:.25rem">Cohortes semanales · % que sigue jugando N semanas después</div>
            <div class="table-wrap">
                <table class="tbl cohort-tbl">
                    <thead>
                        <tr>
                            <th>Semana de 1ª visita</th>
                            <th class="num-h">Nuevos</th>
                            @for (int k = 1; k <= Cs2PlayerStatsCalculator.CohortFollowWeeks; k++)
                            {
                                <th class="num-h">+@k sem</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in gs.Cohorts.Reverse())
                        {
                            <tr class="@(c.Size == 0 ? "row-empty" : "")">
                                <td class="mono">@c.WeekStart.ToString("dd/MM/yyyy")</td>
                                <td class="num">@c.Size</td>
                                @foreach (var v in c.ReturnPct)
                                {
                                    if (v is { } pv)
                                    {
                                        var alpha = (0.08 + pv / 100.0 * 0.5).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
                                        <td class="num cohort-cell" style="background:rgba(167,139,250,@alpha)">@($"{pv:0} %")</td>
                                    }
                                    else
                                    {
                                        <td class="num muted">—</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="kpi-section-lbl" style="margin-top:.25rem">Últimos 30 días</div>
            <div class="charts-grid">
                <div class="chart-card">
                    <p class="chart-title"><i class="ti ti-users"></i> Jugadores únicos por día</p>
                    <div class="chart-wrap"><canvas id="chart-daily-unique"></canvas></div>
                </div>
                <div class="chart-card">
                    <p class="chart-title"><i class="ti ti-user-plus"></i> Jugadores nuevos por día</p>
                    <div class="chart-wrap"><canvas id="chart-daily-new"></canvas></div>
                </div>
            </div>

            <div class="kpi-section-lbl" style="margin-top:.25rem">Jugadores más fieles · top @gs.TopPlayers.Count por días jugados</div>
            <div class="table-wrap">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>Jugador</th>
                            <th class="num-h">Días</th>
                            <th class="num-h">Conexiones</th>
                            <th>Primera vez</th>
                            <th>Última vez</th>
                            @if (GlobalScope == ScopeAll) { <th>Servidores</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tp in gs.TopPlayers)
                        {
                            <tr>
                                <td><span class="player-pill">@tp.Name</span></td>
                                <td class="num">@tp.ActiveDays</td>
                                <td class="num muted">@tp.Connects</td>
                                <td class="mono">@ToMadrid(tp.FirstSeenUtc)</td>
                                <td class="mono">@ToMadrid(tp.LastSeenUtc)</td>
                                @if (GlobalScope == ScopeAll)
                                {
                                    <td class="map-cell">@string.Join(", ", tp.Servers.Select(ServerLabel))</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="count-lbl">Un jugador se identifica por su SteamID; "día" = día natural en hora de Madrid.</p>
        }
    }
    else if (Loading)
    {
        <div class="state-box">
            <div class="spinner"></div>
            <p>Cargando...</p>
        </div>
    }
    else if (Error is not null)
    {
        <div class="state-box state-error">
            <i class="ti ti-alert-circle"></i>
            <p>@Error</p>
        </div>
    }
    else if (Kpi is null)
    {
        <div class="state-box">
            <i class="ti ti-database-off"></i>
            <p>Sin datos todavía. El servicio escribe un snapshot cada 60 s.</p>
        </div>
    }
    else
    {
        @* ── KPIs globales ── *@
        <div class="kpi-section-lbl">Global</div>
        <div class="kpi-grid kpi-grid-3">
            <div class="kpi-card">
                <span class="kpi-icon ki-cyan"><i class="ti ti-database"></i></span>
                <div>
                    <p class="kpi-val">@Kpi.TotalSnapshots</p>
                    <p class="kpi-lbl">Snapshots totales</p>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-icon ki-cyan"><i class="ti ti-calendar-event"></i></span>
                <div>
                    <p class="kpi-val mono-sm">@ToMadrid(Kpi.FirstSnapshot)</p>
                    <p class="kpi-lbl">Primer snapshot</p>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-icon ki-cyan"><i class="ti ti-calendar-check"></i></span>
                <div>
                    <p class="kpi-val mono-sm">@ToMadrid(Kpi.LastSnapshot)</p>
                    <p class="kpi-lbl">Último snapshot</p>
                </div>
            </div>
        </div>

        @* ── KPIs 24h ── *@
        <div class="kpi-section-lbl" style="margin-top:.25rem">Últimas 24 horas</div>
        <div class="kpi-grid kpi-grid-4">
            <div class="kpi-card">
                <span class="kpi-icon ki-green"><i class="ti ti-users"></i></span>
                <div>
                    <p class="kpi-val">@Kpi.MaxPlayers24h</p>
                    <p class="kpi-lbl">Jugadores máx.</p>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-icon ki-cyan"><i class="ti ti-users"></i></span>
                <div>
                    <p class="kpi-val">@($"{Kpi.AvgPlayers24h:0.#}")</p>
                    <p class="kpi-lbl">Jugadores media</p>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-icon ki-purple"><i class="ti ti-user-check"></i></span>
                <div>
                    <p class="kpi-val">@Kpi.UniquePlayers24h</p>
                    <p class="kpi-lbl">Jugadores únicos</p>
                </div>
            </div>
            <div class="kpi-card">
                <span class="kpi-icon @(Kpi.UptimePct24h >= 90 ? "ki-green" : Kpi.UptimePct24h >= 60 ? "ki-amber" : "ki-red")">
                    <i class="ti ti-heartbeat"></i>
                </span>
                <div>
                    <p class="kpi-val @(Kpi.UptimePct24h >= 90 ? "" : Kpi.UptimePct24h >= 60 ? "mid" : "hi")">
                        @($"{Kpi.UptimePct24h:0.#} %")
                    </p>
                    <p class="kpi-lbl">Uptime</p>
                </div>
            </div>
        </div>

        @* ── Sesiones de jugadores (eventos exactos de conexión/desconexión, últimas 24h) ── *@
        @if (PlayerSessions.Count > 0)
        {
            <div class="kpi-section-lbl" style="margin-top:.25rem">Sesiones · últimas 24h (hora exacta, incluye visitas cortas)</div>
            <div class="sessions-grid">
                @foreach (var g in PlayerSessions.GroupBy(s => s.Name).OrderByDescending(g => g.Max(s => s.End)))
                {
                    var total = TimeSpan.FromTicks(g.Sum(s => s.Duration.Ticks));
                    var first = g.Min(s => s.Start);
                    var last = g.Max(s => s.End);
                    var anyOngoing = g.Any(s => s.Ongoing);
                    <div class="session-card">
                        <div class="session-name">
                            <i class="ti ti-user"></i>
                            <span>@g.Key</span>
                        </div>
                        <div class="session-total">
                            <span class="total-badge @(anyOngoing ? "range-dur-live" : "")">Total: @FormatDuration(total)</span>
                            <span class="total-range">@ToMadridTime(first) → @(anyOngoing ? "ahora" : ToMadridTime(last))</span>
                        </div>
                        <div class="session-ranges">
                            @foreach (var s in g.OrderByDescending(s => s.End))
                            {
                                <div class="session-range">
                                    <span class="range-times">
                                        <i class="ti ti-clock-play"></i>
                                        @ToMadridTime(s.Start)
                                        <span class="range-arrow">→</span>
                                        @(s.Ongoing ? "ahora" : ToMadridTime(s.End))
                                    </span>
                                    <span class="range-dur @(s.Ongoing ? "range-dur-live" : "")">@FormatDuration(s.Duration)</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (!Loading)
        {
            <div class="kpi-section-lbl" style="margin-top:.25rem">Sesiones · últimas 24h</div>
            <p class="muted" style="font-size:12px;padding:4px 2px;">Sin conexiones registradas en las últimas 24h.</p>
        }

        @* ── Mapas favoritos (histórico completo, por tiempo de juego) ── *@
        @if (MapStats.Count > 0)
        {
            <div class="kpi-section-lbl" style="margin-top:.25rem">Mapas favoritos · histórico completo</div>
            <div class="maprank-list">
                @foreach (var (m, i) in MapStats.Select((m, i) => (m, i)))
                {
                    var pct = maxMapHours <= 0 ? 0 : (m.PlayerHours / maxMapHours * 100);
                    <div class="maprank-item">
                        <span class="maprank-pos">@(i + 1)</span>
                        <div class="maprank-body">
                            <div class="maprank-top">
                                <span class="maprank-name">@m.Map</span>
                                <span class="maprank-hours">@($"{m.PlayerHours:0.#} h·jugador")</span>
                            </div>
                            <div class="maprank-bar-bg"><div class="maprank-bar-fill" style="width:@(pct.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                            <div class="maprank-meta">
                                <span><i class="ti ti-repeat"></i> @m.TimesPlayed @(m.TimesPlayed == 1 ? "vez" : "veces")</span>
                                <span><i class="ti ti-users"></i> pico @m.PeakPlayers</span>
                                <span><i class="ti ti-chart-line"></i> media @($"{m.AvgPlayers:0.#}")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* ── Gráficas 24h ── *@
        @if (Chart is not null)
        {
            <div class="kpi-section-lbl" style="margin-top:.25rem">Gráficas · últimas 24 h</div>
            <div class="charts-grid">
                <div class="chart-card">
                    <p class="chart-title"><i class="ti ti-users"></i> Jugadores online</p>
                    <div class="chart-wrap"><canvas id="chart-players"></canvas></div>
                </div>
                <div class="chart-card">
                    <p class="chart-title"><i class="ti ti-heartbeat"></i> Estado online/offline</p>
                    <div class="chart-wrap"><canvas id="chart-online"></canvas></div>
                </div>
            </div>
        }

        @* ── Tabla ── *@
        @if (Rows.Count > 0)
        {
            <div class="table-header-row">
                <div class="kpi-section-lbl">Últimos 100 registros · @Kpi.TotalSnapshots en total</div>
                <label class="toggle-empty">
                    <input type="checkbox" @bind="HideEmpty" />
                    <span>Ocultar vacíos</span>
                </label>
            </div>
            <div class="table-wrap">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th>Mapa</th>
                            <th class="th-players">Jugadores</th>
                            <th class="th-names">Conectados</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Rows)
                        {
                            var hasPlayers = r.CurrentPlayers > 0;
                            if (HideEmpty && !hasPlayers) continue;
                            var names = SessionsByTs.TryGetValue(r.TimestampUtc, out var n) ? n : null;
                            <tr class="@(!hasPlayers ? "row-empty" : "")">
                                <td class="mono">@ToMadrid(r.TimestampUtc)</td>
                                <td>
                                    @if (!r.IsOnline)
                                    {
                                        <span class="badge badge-off">Offline</span>
                                    }
                                    else if (!hasPlayers)
                                    {
                                        <span class="badge badge-idle">Vacío</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-on">@r.CurrentPlayers / @r.MaxPlayers</span>
                                    }
                                </td>
                                <td class="map-cell">@(r.Map ?? "—")</td>
                                <td class="num @(!hasPlayers ? "muted" : "")">
                                    @if (hasPlayers)
                                    {
                                        <span class="player-count">@r.CurrentPlayers</span>
                                    }
                                    else
                                    {
                                        <span class="muted">0</span>
                                    }
                                </td>
                                <td class="names-cell">
                                    @if (names is { Count: > 0 })
                                    {
                                        <div class="names-wrap">
                                            @foreach (var name in names)
                                            {
                                                <span class="player-pill">@name</span>
                                            }
                                        </div>
                                    }
                                    else if (hasPlayers)
                                    {
                                        <span class="muted fst">Sin datos de sesión</span>
                                    }
                                    else
                                    {
                                        <span class="muted">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="count-lbl">Mostrando @Rows.Count de @Kpi.TotalSnapshots registros</p>
        }
    }

</div>

@code {
    // Si un Disconnect llega más de esto después de su Connect, casi seguro no es una sesión
    // real — el server se cayó a medio partido (o dejó un cliente fantasma) y este Disconnect
    // es la limpieza tardía, no el momento real en que se fue. Se contrasta contra los
    // snapshots (sondeo cada ~60s) para saber de verdad hasta cuándo estuvo, en vez de fiarnos
    // ciegamente del evento.
    const double MaxPlausibleSessionHours = 9;

    // Dos tramos del mismo jugador separados por menos de esto se muestran como uno solo — un
    // hueco tan corto es una reconexión (cambio de mapa, un reinicio nuestro), no que se fuera.
    const double MergeGapMinutes = 5;

    record KpiData(
        long     TotalSnapshots,
        DateTime FirstSnapshot,
        DateTime LastSnapshot,
        int      MaxPlayers24h,
        double   AvgPlayers24h,
        double   UptimePct24h,
        long     Snapshots24h,
        int      UniquePlayers24h);

    record ChartData(string[] Labels, double[] Players, double[] Online, string[][] PlayerNames);

    record PlayerSessionRange(string Name, DateTime Start, DateTime End, bool Ongoing)
    {
        public TimeSpan Duration => End - Start;
    }

    record MapStat(string Map, double PlayerHours, int TimesPlayed, int PeakPlayers, double AvgPlayers);

    KpiData?                              Kpi;
    ChartData?                            Chart;
    List<Cs2ServerSnapshot>               Rows           = new();
    Dictionary<DateTime, List<string>>    SessionsByTs   = new();
    List<PlayerSessionRange>              PlayerSessions = new();
    List<MapStat>                         MapStats       = new();
    double                                maxMapHours    = 0;
    bool                                  Loading        = true;
    bool                                  HideEmpty      = true;
    string?                               Error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) { await LoadAsync(); return; }
        if (ShowGlobal)
        {
            if (Global is not null && GlobalChartsPending)
            {
                GlobalChartsPending = false;
                await JS.InvokeVoidAsync("spRenderChart", "chart-daily-unique", Global.DailyLabels, Global.DailyUnique, "Únicos", "#a78bfa", "");
                await JS.InvokeVoidAsync("spRenderChart", "chart-daily-new", Global.DailyLabels, Global.DailyNew, "Nuevos", "#4ade80", "");
            }
            return;
        }
        if (Chart is not null) await RenderChartsAsync();
    }

    // ── Vista global (jugadores únicos + retención) ──
    const string ScopeAll = "*";

    Cs2GlobalPlayerStats? Global;
    bool    ShowGlobal;
    bool    GlobalLoading;
    bool    GlobalChartsPending;
    string? GlobalError;
    string  GlobalScope = ScopeAll;
    string? GlobalLoadedScope;

    string ScopeLabel => GlobalScope == ScopeAll ? "ambos servidores" : ServerLabel(GlobalScope);

    string ServerLabel(string key) =>
        ActiveServer.Servers.FirstOrDefault(s => s.Name == key)?.Label ?? key;

    async Task ToggleGlobalAsync()
    {
        ShowGlobal = !ShowGlobal;
        if (ShowGlobal)
        {
            if (GlobalLoadedScope != GlobalScope) await LoadGlobalAsync();
            else GlobalChartsPending = true; // los canvas se vuelven a crear al cambiar de vista
        }
    }

    async Task SetScopeAsync(string scope)
    {
        if (GlobalLoading || scope == GlobalScope) return;
        GlobalScope = scope;
        await LoadGlobalAsync();
    }

    Task RefreshAsync() => ShowGlobal ? LoadGlobalAsync() : LoadAsync();

    async Task LoadGlobalAsync()
    {
        GlobalLoading = true;
        GlobalError   = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            // Solo servidores configurados en el panel: el alcance "ambos" no debe arrastrar
            // eventos de un ServerName desconocido que haya publicado alguien en la cola.
            var keys = GlobalScope == ScopeAll
                ? ActiveServer.Servers.Select(s => s.Name).ToList()
                : ActiveServer.Servers.Where(s => s.Name == GlobalScope).Select(s => s.Name).ToList();

            // Contexto propio: LoadAsync puede seguir usando Db a la vez (DbContext no es concurrente).
            await using var db = await DbFactory.CreateDbContextAsync();
            var rows = await db.Cs2PlayerConnectionEvents.AsNoTracking()
                .Where(e => e.EventType == Cs2ConnectionEventType.Connect
                         && e.ServerName != null && keys.Contains(e.ServerName))
                .Select(e => new { e.TimestampUtc, e.PlayerName, e.SteamId64, e.ServerName })
                .ToListAsync();

            Global = Cs2PlayerStatsCalculator.Compute(
                rows.Select(r => new Cs2ConnectRecord(r.TimestampUtc, r.PlayerName, r.SteamId64, r.ServerName!)),
                DateTime.UtcNow,
                _madrid);
            GlobalLoadedScope   = GlobalScope;
            GlobalChartsPending = true;
        }
        catch (Exception ex)
        {
            Global      = null;
            GlobalError = ex.Message;
        }
        finally
        {
            GlobalLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task LoadAsync()
    {
        Loading = true;
        Error   = null;
        Chart   = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            var cutoff = DateTime.UtcNow.AddHours(-24);
            var serverKey = ActiveServer.Active.Name;

            var g = await Db.Cs2ServerSnapshots.Where(_sk => _sk.ServerKey == serverKey)
                .GroupBy(_ => 1)
                .Select(g => new {
                    Total = g.LongCount(),
                    First = g.Min(s => s.TimestampUtc),
                    Last  = g.Max(s => s.TimestampUtc)
                })
                .FirstOrDefaultAsync();

            var h = await Db.Cs2ServerSnapshots.Where(_sk => _sk.ServerKey == serverKey)
                .Where(s => s.TimestampUtc >= cutoff)
                .GroupBy(_ => 1)
                .Select(g => new {
                    MaxPlayers  = g.Max(s => s.CurrentPlayers),
                    AvgPlayers  = g.Average(s => (double)s.CurrentPlayers),
                    OnlineCount = g.Count(s => s.IsOnline),
                    Total       = g.Count()
                })
                .FirstOrDefaultAsync();

                // 24h player sessions — used for KPIs and chart
            var raw24h = await Db.Cs2PlayerSessions.Where(_sk => _sk.ServerKey == serverKey)
                .Where(s => s.TimestampUtc >= cutoff)
                .Select(s => new { s.TimestampUtc, s.PlayerName })
                .OrderBy(s => s.TimestampUtc)
                .ToListAsync();

            var uniquePlayers24h = raw24h.Select(s => s.PlayerName).Distinct().Count();

            // Last 100 snapshots for the table
            Rows = await Db.Cs2ServerSnapshots.Where(_sk => _sk.ServerKey == serverKey)
                .OrderByDescending(s => s.TimestampUtc)
                .Take(100)
                .ToListAsync();

            // "Conectados" por fila de la tabla de snapshots — sigue basado en Cs2PlayerSessions
            // porque está atado 1:1 al timestamp de cada snapshot.
            if (Rows.Count > 0)
            {
                var oldest = Rows[^1].TimestampUtc;
                var rawSessions = await Db.Cs2PlayerSessions.Where(_sk => _sk.ServerKey == serverKey)
                    .Where(s => s.TimestampUtc >= oldest)
                    .Select(s => new { s.TimestampUtc, s.PlayerName })
                    .OrderBy(s => s.TimestampUtc)
                    .ToListAsync();

                SessionsByTs = rawSessions
                    .GroupBy(s => s.TimestampUtc)
                    .ToDictionary(grp => grp.Key, grp => grp.Select(s => s.PlayerName).Distinct().ToList());
            }

            // Sesiones exactas de conexión/desconexión (últimas 24h) — a diferencia de arriba,
            // esto viene de los eventos reales del log del servidor, no de un sondeo cada
            // minuto, así que capta también visitas de pocos segundos.
            var connectionEvents = await Db.Cs2PlayerConnectionEvents.Where(_sk => _sk.ServerName == serverKey)
                .Where(e => e.TimestampUtc >= cutoff)
                .OrderBy(e => e.TimestampUtc)
                .Select(e => new { e.TimestampUtc, e.PlayerName, e.EventType })
                .ToListAsync();

            var nowUtc = DateTime.UtcNow;

            // Si el server se cae, el evento de desconexión nunca llega a publicarse — sin esto,
            // esa conexión se queda "abierta" para siempre y su duración crece cada vez que se
            // recarga la página. Para cerrarla usamos la ÚLTIMA VEZ QUE ESE JUGADOR CONCRETO
            // apareció en un snapshot (no "el snapshot más reciente en general" — si el server
            // estuvo caído horas, el snapshot más reciente es de mucho después de que el
            // jugador se fuera de verdad, y daría una hora de corte engañosa).
            var latestSnapshot = Rows.Count > 0 ? Rows[0] : null;
            var currentlyConnected = latestSnapshot is not null && SessionsByTs.TryGetValue(latestSnapshot.TimestampUtc, out var liveNames)
                ? new HashSet<string>(liveNames, StringComparer.OrdinalIgnoreCase)
                : new HashSet<string>();
            var lastSeenByPlayer = raw24h
                .GroupBy(s => s.PlayerName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Max(s => s.TimestampUtc), StringComparer.OrdinalIgnoreCase);

            // raw24h ya viene ordenado por TimestampUtc — GroupBy conserva ese orden, así que
            // cada lista queda ascendente sin tener que volver a ordenar.
            var snapshotTimesByPlayer = raw24h
                .GroupBy(s => s.PlayerName, StringComparer.OrdinalIgnoreCase)
                .ToDictionary(g => g.Key, g => g.Select(s => s.TimestampUtc).ToList(), StringComparer.OrdinalIgnoreCase);

            DateTime? LastSnapshotBetween(string player, DateTime after, DateTime before)
            {
                if (!snapshotTimesByPlayer.TryGetValue(player, out var times)) return null;
                DateTime? last = null;
                foreach (var t in times)
                {
                    if (t <= after) continue;
                    if (t >= before) break;
                    last = t;
                }
                return last;
            }

            PlayerSessions = connectionEvents
                .GroupBy(e => e.PlayerName)
                .SelectMany(grp =>
                {
                    var sessions = new List<PlayerSessionRange>();
                    DateTime? openStart = null;

                    foreach (var e in grp)
                    {
                        if (e.EventType == Cs2ConnectionEventType.Connect)
                        {
                            // Conexión sin desconexión previa vista (hueco de log, reconexión
                            // rápida...) — cerramos la anterior en su propio instante en vez
                            // de perderla.
                            if (openStart is { } prevStart)
                                sessions.Add(new(grp.Key, prevStart, prevStart, Ongoing: false));
                            openStart = e.TimestampUtc;
                        }
                        else if (openStart is { } start)
                        {
                            var end = e.TimestampUtc;
                            if ((end - start).TotalHours >= MaxPlausibleSessionHours)
                                end = LastSnapshotBetween(grp.Key, start, end) ?? start;
                            sessions.Add(new(grp.Key, start, end, Ongoing: false));
                            openStart = null;
                        }
                        // Desconexión sin conexión previa vista (empieza a mitad de sesión,
                        // fuera de la ventana de 24h) — se ignora, no hay Start fiable.
                    }

                    if (openStart is { } stillOpen)
                    {
                        bool reallyOnline = currentlyConnected.Contains(grp.Key);
                        DateTime closeAt;
                        if (reallyOnline)
                            closeAt = nowUtc;
                        else if (lastSeenByPlayer.TryGetValue(grp.Key, out var lastSeen) && lastSeen > stillOpen)
                            closeAt = lastSeen; // último snapshot en el que ESTE jugador salió conectado
                        else
                            closeAt = stillOpen; // ni un snapshot lo pilló — mejor duración ~0 que inventar una hora
                        sessions.Add(new(grp.Key, stillOpen, closeAt, Ongoing: reallyOnline));
                    }

                    // Reconexiones casi pegadas (cambio de mapa, un reinicio nuestro del
                    // servidor...) son tiempo jugado seguido para el jugador, no visitas
                    // distintas — se fusionan en un solo bloque en vez de llenar la lista de
                    // filas de "< 2 min".
                    var merged = new List<PlayerSessionRange>();
                    foreach (var s in sessions)
                    {
                        if (merged.Count > 0 && !merged[^1].Ongoing &&
                            (s.Start - merged[^1].End).TotalMinutes <= MergeGapMinutes)
                            merged[^1] = merged[^1] with { End = s.End, Ongoing = s.Ongoing };
                        else
                            merged.Add(s);
                    }

                    return merged;
                })
                .OrderByDescending(s => s.End)
                .Take(60)
                .ToList();

            // Mapas favoritos — histórico completo. PlayerHours sale de sumar CurrentPlayers
            // en cada snapshot (uno cada ~60s) y pasarlo a horas; es la mejor medida de
            // "favorito" que da esta tabla: pondera tiempo jugado Y cuánta gente había.
            var mapAgg = await Db.Cs2ServerSnapshots.Where(_sk => _sk.ServerKey == serverKey)
                .Where(s => s.IsOnline && s.Map != null)
                .GroupBy(s => s.Map)
                .Select(g => new {
                    Map         = g.Key!,
                    TotalPlayerMinutes = g.Sum(s => s.CurrentPlayers),
                    PeakPlayers = g.Max(s => s.CurrentPlayers),
                    AvgPlayers  = g.Average(s => (double)s.CurrentPlayers)
                })
                .ToListAsync();

            // "Veces jugado" no se puede sacar con un GROUP BY (hace falta ver el orden y
            // detectar cambios de mapa consecutivos) — pasada ligera en memoria, solo 2 columnas.
            var mapTimeline = await Db.Cs2ServerSnapshots.Where(_sk => _sk.ServerKey == serverKey)
                .Where(s => s.IsOnline && s.Map != null)
                .OrderBy(s => s.TimestampUtc)
                .Select(s => s.Map!)
                .ToListAsync();

            var timesPlayed = new Dictionary<string, int>();
            string? prevMap = null;
            foreach (var map in mapTimeline)
            {
                if (map != prevMap)
                {
                    timesPlayed[map] = timesPlayed.GetValueOrDefault(map) + 1;
                    prevMap = map;
                }
            }

            MapStats = mapAgg
                .Select(a => new MapStat(
                    Map:         a.Map,
                    PlayerHours: a.TotalPlayerMinutes / 60.0,
                    TimesPlayed: timesPlayed.GetValueOrDefault(a.Map, 1),
                    PeakPlayers: a.PeakPlayers,
                    AvgPlayers:  a.AvgPlayers))
                .OrderByDescending(m => m.PlayerHours)
                .Take(12)
                .ToList();

            maxMapHours = MapStats.Count > 0 ? MapStats.Max(m => m.PlayerHours) : 0;

            // 24h chart data
            var chartRows = await Db.Cs2ServerSnapshots.Where(_sk => _sk.ServerKey == serverKey)
                .Where(s => s.TimestampUtc >= cutoff)
                .OrderBy(s => s.TimestampUtc)
                .Select(s => new { s.TimestampUtc, s.CurrentPlayers, s.IsOnline })
                .ToListAsync();

            var chartSessions = raw24h
                .GroupBy(s => s.TimestampUtc)
                .ToDictionary(grp => grp.Key, grp => grp.Select(s => s.PlayerName).Distinct().ToList());

            if (g is null) { Kpi = null; return; }

            double uptimePct = h is { Total: > 0 } ? h.OnlineCount * 100.0 / h.Total : 0;

            Kpi = new KpiData(
                TotalSnapshots:   g.Total,
                FirstSnapshot:    g.First,
                LastSnapshot:     g.Last,
                MaxPlayers24h:    h?.MaxPlayers ?? 0,
                AvgPlayers24h:    h?.AvgPlayers ?? 0,
                UptimePct24h:     uptimePct,
                Snapshots24h:     h?.Total ?? 0,
                UniquePlayers24h: uniquePlayers24h);

            if (chartRows.Count > 0)
            {
                Chart = new ChartData(
                    Labels:      chartRows.Select(r => r.TimestampUtc.ToString("HH:mm")).ToArray(),
                    Players:     chartRows.Select(r => (double)r.CurrentPlayers).ToArray(),
                    Online:      chartRows.Select(r => r.IsOnline ? 1.0 : 0.0).ToArray(),
                    PlayerNames: chartRows.Select(r =>
                        chartSessions.TryGetValue(r.TimestampUtc, out var ns)
                            ? ns.ToArray()
                            : Array.Empty<string>()
                    ).ToArray()
                );
            }
        }
        catch (Exception ex)
        {
            Error = ex.Message;
        }
        finally
        {
            Loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task RenderChartsAsync()
    {
        if (Chart is null) return;
        await JS.InvokeVoidAsync("spRenderChartWithPlayers", "chart-players", Chart.Labels, Chart.Players, "Jugadores", "#22d3ee", Chart.PlayerNames);
        await JS.InvokeVoidAsync("spRenderChart", "chart-online", Chart.Labels, Chart.Online, "Online", "#4ade80", "");
    }

    static readonly TimeZoneInfo _madrid =
        TimeZoneInfo.FindSystemTimeZoneById(
            OperatingSystem.IsWindows() ? "Romance Standard Time" : "Europe/Madrid");

    static string ToMadrid(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(utc, _madrid).ToString("dd/MM HH:mm");

    static string ToMadridDate(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(utc, _madrid).ToString("dd/MM/yyyy");

    static string ToMadridTime(DateTime utc) =>
        TimeZoneInfo.ConvertTimeFromUtc(utc, _madrid).ToString("HH:mm");

    static string FormatDuration(TimeSpan d)
    {
        if (d.TotalHours >= 1)
            return $"{(int)d.TotalHours}h {d.Minutes:D2}m";
        if (d.TotalMinutes >= 2)
            return $"{(int)d.TotalMinutes} min";
        return "< 2 min";
    }
}

@page "/players"
@rendermode InteractiveServer

@using ServerPanel.Models
@using ServerPanel.Contracts
@using Microsoft.AspNetCore.Authorization
@using ServerPanel.Components.Pages.Players.Modals

@attribute [Authorize]

@inject IPlayerService PlayerService
@inject ILogger<Players> Logger
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResource> L

<div class="pl-page">

    <!-- ── Header ── -->
    <div class="pl-header">
        <div class="pl-header-left">
            <div class="pl-header-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                </svg>
            </div>
            <div>
                <div class="pl-title">@L["Players.Title"]</div>
                <div class="pl-subtitle">
                    <span class="pl-count">@Model.Players.Count</span>
                    @L["Players.Connected"]
                </div>
            </div>
        </div>
        <button class="pl-refresh-btn" @onclick="LoadPlayers" disabled="@Model.Loading">
            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
                <path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" />
            </svg>
            @L["Players.Refresh"]
        </button>
    </div>

    <!-- ── Unban ── -->
    <div class="pl-unban-bar">
        <div class="pl-unban-icon"><i class="ti ti-lock-open"></i></div>
        <input class="pl-unban-inp" @bind="UnbanTarget" @bind:event="oninput"
               placeholder="@L["Players.UnbanPlaceholder"]"
               @onkeydown="@(async e => { if (e.Key == "Enter") await HandleUnban(); })" />
        <button class="pl-unban-btn" @onclick="HandleUnban" disabled="@string.IsNullOrWhiteSpace(UnbanTarget)">
            @L["Players.Unban"]
        </button>
    </div>

    <!-- ── Status message (solo éxitos/info, no errores de conexión) ── -->
    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage) && !Model.HasError)
    {
        <div class="pl-status-msg">
            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
            @Model.StatusMessage
        </div>
    }

    <!-- ── Loading ── -->
    @if (Model.Loading)
    {
        <div class="pl-loading">
            <div class="pl-spinner"></div>
            <span>@L["Players.Loading"]</span>
        </div>
    }
    else if (!Model.Players.Any())
    {
        @if (Model.HasError)
        {
            <div class="pl-empty" style="gap:10px">
                <svg viewBox="0 0 24 24" fill="currentColor" width="40" height="40" style="opacity:.5;color:#ef4444">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                </svg>
                <span style="color:#ef4444;font-weight:600">Error al leer jugadores</span>
                <span style="font-size:12px;opacity:.8;max-width:500px;text-align:center">@Model.StatusMessage</span>
                @if (!string.IsNullOrEmpty(Model.RawStatus))
                {
                    <details style="width:100%;max-width:600px;text-align:left">
                        <summary style="cursor:pointer;font-size:12px;opacity:.7;padding:4px">Ver output de RCON status (para diagnóstico)</summary>
                        <pre style="font-size:10px;opacity:.7;background:rgba(0,0,0,.3);padding:8px;border-radius:4px;overflow-x:auto;margin-top:4px;white-space:pre-wrap">@Model.RawStatus</pre>
                    </details>
                }
                <button class="pl-refresh-btn" style="margin-top:4px" @onclick="LoadPlayers">Reintentar</button>
            </div>
        }
        else
        {
            <div class="pl-empty">
                <svg viewBox="0 0 24 24" fill="currentColor" width="40" height="40" style="opacity:.3">
                    <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                </svg>
                <span>@L["Players.Empty"]</span>
            </div>
        }
    }
    else
    {
        <!-- ── Table ── -->
        <div class="pl-table-wrap">
            <table class="pl-table">
                <thead>
                    <tr>
                        <th>@L["Players.Col.Player"]</th>
                        <th class="pl-th-center">ID</th>
                        <th class="pl-th-center">Ping</th>
                        <th class="pl-th-center">@L["Players.Col.Type"]</th>
                        <th>@L["Players.Col.Group"]</th>
                        <th class="pl-th-right">@L["Players.Col.Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in PagedPlayers)
                    {
                        <tr class="pl-row" @onclick="() => ShowProfile(player)">

                            <!-- Name + SteamID -->
                            <td class="pl-td-player">
                                <div class="pl-player-avatar @(player.IsBot ? "pl-avatar-bot" : "pl-avatar-human")">
                                    @if (player.IsBot)
                                    {
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7H3a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2M7 14v2a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-2H7M9 9a1 1 0 0 0 0 2 1 1 0 0 0 0-2m6 0a1 1 0 0 0 0 2 1 1 0 0 0 0-2z" /></svg>
                                    }
                                    else
                                    {
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                                    }
                                </div>
                                <div class="pl-player-info">
                                    <div class="pl-player-name">@player.Name</div>
                                    @if (!player.IsBot)
                                    {
                                        <div class="pl-player-steam">@player.SteamId</div>
                                    }
                                </div>
                            </td>

                            <!-- ID -->
                            <td class="pl-td-center pl-td-mono">@player.UserId</td>

                            <!-- Ping -->
                            <td class="pl-td-center">
                                <span class="pl-ping @PingClass(player.Ping)">@player.Ping ms</span>
                            </td>

                            <!-- Tipo -->
                            <td class="pl-td-center">
                                @if (player.IsBot)
                                {
                                    <span class="pl-badge pl-badge-bot">BOT</span>
                                }
                                else
                                {
                                    <span class="pl-badge pl-badge-human">@L["Players.Human"]</span>
                                }
                            </td>

                            <!-- Grupo / Clan -->
                            <td class="pl-td-group">
                                @if (!string.IsNullOrWhiteSpace(player.Groups))
                                {
                                    <span class="pl-badge pl-badge-group">@player.Groups</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(player.Clan))
                                {
                                    <span class="pl-clan">@player.Clan</span>
                                }
                                @if (string.IsNullOrWhiteSpace(player.Groups) && string.IsNullOrWhiteSpace(player.Clan))
                                {
                                    <span class="pl-empty-cell">—</span>
                                }
                            </td>

                            <!-- Actions -->
                            <td class="pl-td-actions" @onclick:stopPropagation="true">
                                @if (!player.IsBot)
                                {
                                    @if (!string.IsNullOrWhiteSpace(player.CommunityUrl))
                                    {
                                        <a href="@player.CommunityUrl" target="_blank" class="pl-action-btn pl-action-steam" title="Steam">
                                            <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13"><path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.029 4.524 4.524s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0z" /></svg>
                                            Steam
                                        </a>
                                    }
                                    <button class="pl-action-btn pl-action-kick"
                                            @onclick='() => OpenReasonModal(player, "kick")'
                                            title="Kick">
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                                            <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21a9 9 0 0 0 0-18z" />
                                        </svg>
                                        Kick
                                    </button>

                                    <button class="pl-action-btn pl-action-mute"
                                            @onclick='() => OpenReasonModal(player, "mute")'
                                            title="Mute">
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                                            <path d="M16.5 12c0-2.485-2.015-4.5-4.5-4.5S7.5 9.515 7.5 12s2.015 4.5 4.5 4.5 4.5-2.015 4.5-4.5zm-4.5 3a3 3 0 1 1 0-6 3 3 0 0 1 0 6z" />
                                        </svg>
                                        Mute
                                    </button>

                                    <button class="pl-action-btn pl-action-gag"
                                            @onclick='() => OpenReasonModal(player, "gag")'
                                            title="Gag">
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                                            <circle cx="12" cy="12" r="10" stroke="#fbbf24" stroke-width="2" fill="none" />
                                            <rect x="7" y="11" width="10" height="2" fill="#fbbf24" />
                                        </svg>
                                        Gag
                                    </button>

                                    <button class="pl-action-btn pl-action-ban"
                                            @onclick='() => OpenReasonModal(player, "ban")'
                                            title="Ban">
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                                            <circle cx="12" cy="12" r="10" stroke="red" stroke-width="2" fill="none" />
                                            <line x1="8" y1="8" x2="16" y2="16" stroke="red" stroke-width="2" />
                                        </svg>
                                        Ban
                                    </button>
                                    <button class="pl-action-btn pl-action-unban"
                                            @onclick='() => OpenReasonModal(player, "unban")'
                                            title="Unban">
                                        <svg viewBox="0 0 24 24" fill="currentColor" width="13" height="13">
                                            <circle cx="12" cy="12" r="10" stroke="#22c55e" stroke-width="2" fill="none" />
                                            <line x1="8" y1="16" x2="16" y2="8" stroke="#22c55e" stroke-width="2" />
                                        </svg>
                                        Unban
                                    </button>
                                }
                                else
                                {
                                    <span class="pl-empty-cell">@L["Players.ServerBot"]</span>
                                }
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ── Pagination ── -->
        @if (TotalPages > 1)
        {
            <div class="pl-pager">
                <span class="pl-pager-info">
                    @L["Players.Pager.Showing"] <strong>@PagerFrom–@PagerTo</strong> @L["Players.Pager.Of"] <strong>@Model.Players.Count</strong> @L["Players.Pager.Players"]
                </span>
                <div class="pl-pager-btns">
                    <button class="pl-page-btn" @onclick="PreviousPage" disabled="@(Model.CurrentPage == 1)" title="Anterior">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>
                    </button>
                    @foreach (var i in VisiblePages())
                    {
                        @if (i == 0)
                        {
                            <span class="pl-page-ellipsis">…</span>
                        }
                        else
                        {
                            <button class="pl-page-btn @(Model.CurrentPage == i ? "pl-page-active" : "")" @onclick="() => GoToPage(i)">@i</button>
                        }
                    }
                    <button class="pl-page-btn" @onclick="NextPage" disabled="@(Model.CurrentPage == TotalPages)" title="Siguiente">
                        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
                    </button>
                </div>
            </div>
        }
    }

</div>

<PlayerProfileModal SelectedPlayer="SelectedPlayer" CloseProfile="EventCallback.Factory.Create(this, CloseProfile)" />

<ReasonModal Show="@ShowReasonModal"
             Title="@ReasonTitle"
             ShowReason="@ShowReason"
             ShowDuration="@ShowReasonDuration"
             DurationMinutes="@ReasonDuration"
              SelectedAction="@SelectedModalAction"
              TargetPlayerName="@SelectedActionPlayer?.Name"
              OnConfirmResult="@(EventCallback.Factory.Create<ModalResult>(this, OnReasonConfirm))"
             OnCancel="OnReasonCancel" />

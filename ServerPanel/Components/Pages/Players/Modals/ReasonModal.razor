@* ReasonModal.razor: Modal reutilizable para pedir motivo de Kick/Mute/Gag/Ban *@
@inject ILogger<ReasonModal> Log
@if (Show)
{
    <div class="modal-backdrop show" @onclick="OnCancel"></div>
    <div class="modal d-block" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content reason-modal-content">
                <div class="modal-header reason-modal-header">
                    <h5 class="modal-title">@Title</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="OnCancel" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (ShowReason)
                    {
                        <label for="reasonInput" class="form-label">Motivo:</label>
                        <input id="reasonInput" class="form-control mb-3"
                               @bind="Reason" @bind:event="oninput"
                               maxlength="120" autofocus />
                    }
                    @if (ShowDuration)
                    {
                        <label for="durationInput" class="form-label">Duración (minutos):</label>
                        <input id="durationInput" type="number" min="1" class="form-control"
                               @bind="DurationMinutes" autofocus="@(!ShowReason)" />
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="OnCancel">Cancelar</button>
                    <button class="btn btn-primary" @onclick="Confirm"
                            disabled="@(ShowReason && string.IsNullOrWhiteSpace(Reason))">
                        Confirmar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string Title { get; set; } = "Acción requerida";
    // Backwards-compatible: non-generic OnConfirm used by parent to refresh UI
    [Parameter] public EventCallback OnConfirm { get; set; }
    // Legacy generic result (kept for compatibility but not used for service calls)
    [Parameter] public EventCallback<ModalResult> OnConfirmResult { get; set; }
    [Parameter] public string TargetPlayerName { get; set; } = string.Empty;
    [Parameter] public ModalAction SelectedAction { get; set; } = ModalAction.Kick;
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string Reason { get; set; } = string.Empty;
    [Parameter] public bool ShowReason { get; set; } = true;
    [Parameter] public bool ShowDuration { get; set; }
    [Parameter] public int DurationMinutes { get; set; } = 30;

    private async Task Confirm()
    {
        Log.LogInformation("[ReasonModal] Confirm() fired — Reason='{Reason}' Duration={Duration} HasGeneric={HasGeneric} HasLegacy={HasLegacy}",
            Reason, DurationMinutes, OnConfirmResult.HasDelegate, OnConfirm.HasDelegate);

        if (!OnConfirmResult.HasDelegate && !OnConfirm.HasDelegate)
        {
            Log.LogWarning("[ReasonModal] ningún callback OnConfirm asignado");
            return;
        }

        var result = new ModalResult(Reason, DurationMinutes, SelectedAction);

        // notify parent that action finished
        if (OnConfirm.HasDelegate)
        {
            await OnConfirm.InvokeAsync();
        }

        // keep legacy callback as informational
        if (OnConfirmResult.HasDelegate)
        {
            await OnConfirmResult.InvokeAsync(result);
        }
    }
}

<style>
    .reason-modal-content {
        background: #111827;
        border: 1px solid #1e2a3a;
        border-radius: 14px;
        color: white;
        overflow: hidden;
    }

    .reason-modal-header {
        background: #0d1117;
        border-bottom: 1px solid #1e2a3a;
    }

    .form-label {
        color: #b6c2d6;
        font-weight: 600;
    }

    .form-control {
        background: #181c26;
        color: white;
        border: 1px solid #232b36;
        border-radius: 7px;
    }

        .form-control:focus {
            background: #232b36;
            color: white;
            border-color: #3b82f6;
            box-shadow: 0 0 0 2px #3b82f6;
        }
</style>

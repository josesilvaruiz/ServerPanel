@namespace ServerPanel.Components.Pages
@page "/panel"
@rendermode InteractiveServer

@using ServerPanel.Contracts
@using ServerPanel.Models
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@inject IStringLocalizer<SharedResource> L

<PageTitle>Dashboard — ServerPanel</PageTitle>

<div class="pn-page">

    <!-- ── Header ── -->
    <div class="pn-header">
        <div class="pn-header-left">
            <div class="pn-header-icon">
                <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26">
                    <path d="M21 6.5C21 8.43 19.43 10 17.5 10S14 8.43 14 6.5 15.57 3 17.5 3 21 4.57 21 6.5zM4 6h10v2H4V6zm0 5h6v2H4v-2zm0 5h6v2H4v-2zm8 2v-2h1.68c.16-.73.49-1.4.96-1.96L13 14h-1v-2h3.45C16.16 11.38 17.27 11 18.5 11c1.8 0 3.33.99 4.1 2.44L21 14v2h-.08C20.95 16.64 21 16.82 21 17c0 2.21-1.79 4-4 4s-4-1.79-4-4c0-.18.05-.36.07-.54L12.03 16H12v1H10v-5h2v1z" />
                </svg>
            </div>
            <div>
                <div class="pn-title">@L["Dashboard.Title"]</div>
                <div class="pn-subtitle">
                    @if (ServerInfo is not null)
                    {
                        <span class="pn-server-name">@ServerInfo.ServerName</span>
                    }
                    else
                    {
                        <span>Servidor CS2</span>
                    }
                </div>
            </div>
        </div>
        <div class="pn-header-right">
            @if (Loading)
            {
                <span class="pn-badge pn-badge-loading">@L["Dashboard.Badge.Loading"]</span>
            }
            else if (IsRunning)
            {
                <span class="pn-badge pn-badge-online">
                    <span class="pn-badge-dot pn-badge-dot-green"></span>@L["Dashboard.Online"]
                </span>
            }
            else
            {
                <span class="pn-badge pn-badge-offline">
                    <span class="pn-badge-dot pn-badge-dot-red"></span>@L["Dashboard.Offline"]
                </span>
            }
        </div>
    </div>

    <!-- ── Stats ── -->
    @if (Loading)
    {
        <div class="pn-loading">
            <div class="pn-spinner"></div>
            <span>@L["Dashboard.Loading"]</span>
        </div>
    }
    else if (ServerInfo is not null)
    {
        <div class="pn-stats-grid">
            <div class="pn-stat-card">
                <div class="pn-stat-icon pn-stat-icon-cyan">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M20.5 3l-.16.03L15 5.1 9 3 3.36 4.9c-.21.07-.36.25-.36.48V20.5c0 .28.22.5.5.5l.16-.03L9 18.9l6 2.1 5.64-1.9c.21-.07.36-.25.36-.48V3.5c0-.28-.22-.5-.5-.5zM15 19l-6-2.11V5l6 2.11V19z" />
                    </svg>
                </div>
                <div class="pn-stat-body">
                    <div class="pn-stat-label">@L["Dashboard.Stat.Map"]</div>
                    <div class="pn-stat-value">@ServerInfo.Map</div>
                </div>
            </div>

            <div class="pn-stat-card">
                <div class="pn-stat-icon pn-stat-icon-green">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                    </svg>
                </div>
                <div class="pn-stat-body">
                    <div class="pn-stat-label">@L["Dashboard.Stat.Players"]</div>
                    <div class="pn-stat-value">@ServerInfo.Players<span class="pn-stat-max">/@ServerInfo.MaxPlayers</span></div>
                </div>
            </div>

            <div class="pn-stat-card">
                <div class="pn-stat-icon pn-stat-icon-amber">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5z" />
                    </svg>
                </div>
                <div class="pn-stat-body">
                    <div class="pn-stat-label">@L["Dashboard.Stat.Vac"]</div>
                    <div class="pn-stat-value">@(ServerInfo.Vac == 1 ? L["Dashboard.Stat.VacOn"].Value : L["Dashboard.Stat.VacOff"].Value)</div>
                </div>
            </div>

            <div class="pn-stat-card">
                <div class="pn-stat-icon pn-stat-icon-purple">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h2v2H6zm0 4h8v2H6zm10 0h2v2h-2zm-6-4h8v2h-8z" />
                    </svg>
                </div>
                <div class="pn-stat-body">
                    <div class="pn-stat-label">@L["Dashboard.Stat.Version"]</div>
                    <div class="pn-stat-value pn-mono">@ServerInfo.Version</div>
                </div>
            </div>

            <div class="pn-stat-card">
                <div class="pn-stat-icon pn-stat-icon-blue">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z" />
                    </svg>
                </div>
                <div class="pn-stat-body">
                    <div class="pn-stat-label">@L["Dashboard.Stat.Address"]</div>
                    <div class="pn-stat-value pn-mono">@ServerInfo.Ip:@ServerInfo.Port</div>
                </div>
            </div>

            <div class="pn-stat-card">
                <div class="pn-stat-icon pn-stat-icon-gray">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                        <path d="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7l-2 3v1h8v-1l-2-3h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H3V4h18v12z" />
                    </svg>
                </div>
                <div class="pn-stat-body">
                    <div class="pn-stat-label">@L["Dashboard.Stat.Game"]</div>
                    <div class="pn-stat-value">@ServerInfo.Game</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="pn-offline-card">
            <svg viewBox="0 0 24 24" fill="currentColor" width="36" height="36" style="opacity:.3">
                <path d="M20 18.54L5.46 4 4 5.46 7.03 8.5C5.76 9.07 4.78 10.16 4.34 11.5h1.69c.49-1.17 1.62-2 2.97-2 .23 0 .44.03.64.07L10 10.34c-.32-.08-.65-.13-1-.14V9c-2.05 0-3.8 1.29-4.5 3.12-.18.46-.5.88-.93 1.13-.26.15-.57.25-.57.75 0 .55.45 1 1 1 .4 0 .74-.24.91-.58.83-.77 1.81-1.18 2.59-1.18.33 0 .67.06.97.17L9 14.61c-.31-.08-.65-.11-1-.11-1.1 0-2.1.45-2.83 1.17L4 14.5v2h15l-2-2zM19 13c.55 0 1-.45 1-1 0-.55-.45-1-1-1-.38 0-.7.22-.88.54C17.29 11.22 16.17 10.5 15 10.5c-.64 0-1.23.2-1.74.52L14 11.76c.3-.17.64-.26 1-.26.87 0 1.62.5 2 1.24.26-.09.55-.14.84-.14C17.49 12.6 18.21 13 19 13z" />
            </svg>
            <span>@L["Dashboard.Offline.Msg"]</span>
        </div>
    }

    <!-- ── Control buttons ── -->
    <div class="pn-controls">
        <div class="pn-controls-title">@L["Dashboard.Controls.Title"]</div>
        <div class="pn-controls-grid">
            <button class="pn-btn pn-btn-green" @onclick="StartServer" disabled="@ActionRunning">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M8 5v14l11-7z" /></svg>
                @L["Dashboard.Start"]
            </button>
            <button class="pn-btn pn-btn-amber" @onclick="RestartServer" disabled="@ActionRunning">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z" /></svg>
                @L["Dashboard.Restart"]
            </button>
            <button class="pn-btn pn-btn-red" @onclick="StopServer" disabled="@ActionRunning">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M6 6h12v12H6z" /></svg>
                @L["Dashboard.Stop"]
            </button>
            <button class="pn-btn pn-btn-ghost" @onclick="RefreshStatus" disabled="@ActionRunning">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" /></svg>
                @L["Dashboard.RefreshStatus"]
            </button>
            <button class="pn-btn pn-btn-cyan pn-btn-full" @onclick="UpdateServer" disabled="@ActionRunning">
                <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" /></svg>
                @L["Dashboard.Update"]
            </button>
        </div>
    </div>

    <!-- ── Toast ── -->
    @if (!string.IsNullOrWhiteSpace(StatusMessage))
    {
        <div class="pn-toast">
            <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" /></svg>
            @StatusMessage
        </div>
    }

</div>

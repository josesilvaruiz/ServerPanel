@inject IHttpContextAccessor HttpContextAccessor

@{
    var theme  = HttpContextAccessor.HttpContext?.Request.Cookies["sp-theme"]  ?? "default";
    var layout = HttpContextAccessor.HttpContext?.Request.Cookies["sp-layout"] ?? "sidebar";
}

<!DOCTYPE html>
<html lang="en" data-theme="@theme" data-layout="@(layout)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/panel/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ServerPanel.styles.css"]" />
    <ImportMap />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@@latest/tabler-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@xterm/xterm@@5/css/xterm.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8/dist/browser/signalr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@xterm/xterm@@5/lib/xterm.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@xterm/addon-fit@@0.10/lib/addon-fit.min.js"></script>
    <script src="theme.js"></script>
    <script src="terminal.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="charts.js"></script>
</body>

</html>

@* @* @page "/testa2s"
@rendermode InteractiveServer

@using ServerPanel.Models
@using ServerPanel.Contracts

@inject IServerQueryService Query

<h3>Prueba A2S</h3>

<button class="btn btn-primary"
        @onclick="Load">
    Consultar
</button>

@if (!string.IsNullOrEmpty(Debug))
{
    <div class="alert alert-warning mt-3">
        <pre>@Debug</pre>
    </div>
}

@if (Info != null)
{
    <div class="card mt-3">
        <div class="card-header">
            Información del servidor
        </div>

        <div class="card-body">

            <p>
                <b>Online:</b>
                @(Info.IsOnline ? "Sí" : "No")
            </p>

            <p>
                <b>Servidor:</b>
                @Info.ServerName
            </p>

            <p>
                <b>Mapa:</b>
                @Info.Map
            </p>

            <p>
                <b>Juego:</b>
                @Info.Game
            </p>

            <p>
                <b>Carpeta:</b>
                @Info.Folder
            </p>

            <p>
                <b>AppId:</b>
                @Info.AppId
            </p>

            <p>
                <b>Jugadores:</b>
                @Info.Players/@Info.MaxPlayers
            </p>

            <p>
                <b>Bots:</b>
                @Info.Bots
            </p>

            <p>
                <b>Tipo servidor:</b>
                @Info.ServerType
            </p>

            <p>
                <b>Entorno:</b>
                @Info.Environment
            </p>

            <p>
                <b>Visibilidad:</b>
                @(Info.Visibility == 0 ? "Público" : "Privado")
            </p>

            <p>
                <b>VAC:</b>
                @(Info.Vac == 1 ? "Sí" : "No")
            </p>

            <p>
                <b>Versión:</b>
                @Info.Version
            </p>

            <p>
                <b>IP:</b>
                @Info.Ip:@Info.Port
            </p>

        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header">
            Respuesta A2S (HEX)
        </div>

        <div class="card-body">
            <pre style="white-space: pre-wrap;">@Info.RawResponse</pre>
        </div>
    </div>
}

@code {

    private ServerInfo? Info;

    private string Debug = "";

    private async Task Load()
    {
        try
        {
            Debug = "Consultando servidor...";

            Info = await Query.GetServerInfoAsync();

            Debug =
                $"Consulta completada. Online: {Info.IsOnline}";
        }
        catch (Exception ex)
        {
            Debug = ex.ToString();
        }
    }
} *@ *@
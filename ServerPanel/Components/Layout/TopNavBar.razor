@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResource> L

<div class="nm-tb-inner">

    @* ── Logo ── *@
    <div class="nm-tb-logo">
        <div class="nm-tb-logo-icon">
            <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5z" />
            </svg>
        </div>
        <div class="nm-tb-logo-text">
            <span class="nm-tb-logo-title">ServerPanel</span>
            <span class="nm-tb-logo-sub">CS2 Admin</span>
        </div>
    </div>

    <div class="nm-tb-divider-v"></div>

    @* ── Links ── *@
    <nav class="nm-tb-links">
        <NavLink class="nm-tb-link" href="/panel" Match="NavLinkMatch.All">
            <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15">
                <path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z" />
            </svg>
            <span>@L["Nav.Dashboard"]</span>
        </NavLink>
        <NavLink class="nm-tb-link" href="/players">
            <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15">
                <path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
            </svg>
            <span>@L["Nav.Players"]</span>
        </NavLink>
        <NavLink class="nm-tb-link" href="/admin">
            <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15">
                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5z" />
            </svg>
            <span>@L["Nav.Admin"]</span>
        </NavLink>
    </nav>

    @* ── Hamburger (solo mobile) ── *@
    <button class="nm-tb-hamburger" onclick="navManager.tbToggle()" aria-label="Menu">
        <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z"/>
        </svg>
    </button>

    @* ── Right side ── *@
    <div class="nm-tb-right">
        <ThemePicker />

        <div class="nm-tb-divider-v"></div>

        @* Language switcher *@
        @{
            var currentPath = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            var isEs = System.Globalization.CultureInfo.CurrentCulture.TwoLetterISOLanguageName == "es";
        }
        <div class="nm-tb-lang">
            <a href="/SetCulture?culture=es&returnUrl=@Uri.EscapeDataString(currentPath)" class="nm-lang-btn @(isEs ? "nm-lang-active" : "")" data-enhance-nav="false">ES</a>
            <span class="nm-lang-sep">|</span>
            <a href="/SetCulture?culture=en&returnUrl=@Uri.EscapeDataString(currentPath)" class="nm-lang-btn @(!isEs ? "nm-lang-active" : "")" data-enhance-nav="false">EN</a>
        </div>

        <div class="nm-tb-divider-v"></div>

        <LayoutToggle />

        <AuthorizeView>
            <Authorized>
                <a class="nm-tb-link nm-tb-logout" href="/Logout" title="@L["Nav.Logout"]">
                    <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15">
                        <path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
                    </svg>
                </a>
            </Authorized>
        </AuthorizeView>
    </div>

</div>

@* ── Menú mobile desplegable ── *@
<div class="nm-tb-mobile-menu" onclick="navManager.tbClose()">
    <NavLink class="nm-tb-link nm-tb-mobile-link" href="/panel" Match="NavLinkMatch.All">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg>
        <span>@L["Nav.Dashboard"]</span>
    </NavLink>
    <NavLink class="nm-tb-link nm-tb-mobile-link" href="/players">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
        <span>@L["Nav.Players"]</span>
    </NavLink>
    <NavLink class="nm-tb-link nm-tb-mobile-link" href="/admin">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 4l5 2.18V11c0 3.5-2.33 6.79-5 7.93-2.67-1.14-5-4.43-5-7.93V7.18L12 5z"/></svg>
        <span>@L["Nav.Admin"]</span>
    </NavLink>
    <AuthorizeView>
        <Authorized>
            <a class="nm-tb-link nm-tb-mobile-link" href="/Logout">
                <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/></svg>
                <span>@L["Nav.Logout"]</span>
            </a>
        </Authorized>
    </AuthorizeView>
</div>

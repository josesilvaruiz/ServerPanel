@rendermode InteractiveServer
@inject IJSRuntime JS
@inject ServerPanel.Services.ThemeState ThemeState
@implements IDisposable

<div style="padding:0 0.5rem 0.25rem;">
    <select style="width:100%;background:var(--th-accent-bg);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border:1px solid var(--th-accent-bd);border-radius:9px;color:var(--th-accent);font-family:inherit;font-size:0.8rem;font-weight:600;padding:6px 12px;appearance:none;-webkit-appearance:none;cursor:pointer;outline:none;transition:border-color .15s,box-shadow .15s;" @onchange="OnChange">
        <option value="default" selected="@(ThemeState.Theme == "default")" style="background:#0d1117;color:#e2e8f0;">Default</option>
        <option value="pokemon" selected="@(ThemeState.Theme == "pokemon")" style="background:#0d1117;color:#e2e8f0;">Pokemon</option>
        <option value="zelda"   selected="@(ThemeState.Theme == "zelda")"   style="background:#0d1117;color:#e2e8f0;">Zelda</option>
    </select>
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var theme = await JS.InvokeAsync<string>("themeManager.load");
            ThemeState.Set(theme);
            ThemeState.OnChange += StateHasChanged;
        }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        var key = e.Value?.ToString() ?? "default";
        ThemeState.Set(key);
        await JS.InvokeVoidAsync("themeManager.apply", key);
    }

    public void Dispose() => ThemeState.OnChange -= StateHasChanged;
}

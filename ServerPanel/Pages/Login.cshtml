@page
@model ServerPanel.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Server Panel - Login</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: "Segoe UI", sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: linear-gradient(135deg, #0f172a, #1e293b);
            }

            .login-card {
                width: 100%;
                max-width: 420px;
                background: white;
                padding: 40px;
                border-radius: 20px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.3);
            }

            .logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .logo h1 {
                    color: #0f172a;
                    font-size: 2rem;
                }

                .logo p {
                    color: #64748b;
                    margin-top: 5px;
                }

            .form-group {
                margin-bottom: 18px;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
                color: #334155;
            }

            input {
                width: 100%;
                padding: 14px;
                border: 1px solid #cbd5e1;
                border-radius: 10px;
                font-size: 15px;
                transition: all .2s;
            }

                input:focus {
                    outline: none;
                    border-color: #2563eb;
                    box-shadow: 0 0 0 3px rgba(37,99,235,.15);
                }

            .btn-login {
                width: 100%;
                border: none;
                background: #2563eb;
                color: white;
                padding: 14px;
                border-radius: 10px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s;
            }

                .btn-login:hover {
                    background: #1d4ed8;
                    transform: translateY(-1px);
                }

            .error {
                margin-bottom: 15px;
                padding: 12px;
                background: #fee2e2;
                color: #b91c1c;
                border-radius: 10px;
                border: 1px solid #fecaca;
            }

            .divider {
                display: flex;
                align-items: center;
                gap: 12px;
                margin: 20px 0;
                color: #94a3b8;
                font-size: 13px;
            }

            .divider::before, .divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: #e2e8f0;
            }

            .btn-google {
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 13px;
                border: 1.5px solid #e2e8f0;
                border-radius: 10px;
                background: white;
                font-size: 15px;
                font-weight: 600;
                color: #334155;
                cursor: pointer;
                transition: .2s;
                text-decoration: none;
            }

                .btn-google:hover {
                    background: #f8fafc;
                    border-color: #cbd5e1;
                    box-shadow: 0 2px 8px rgba(0,0,0,.08);
                }

            .footer {
                text-align: center;
                margin-top: 20px;
                color: #94a3b8;
                font-size: 13px;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo">
            <h1>Server Panel</h1>
            <p>Administración del servidor</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error">@Model.Error</div>
        }
        @if (HttpContext.Request.Query["error"] == "unauthorized")
        {
            <div class="error">Tu cuenta de Google no tiene acceso a este panel.</div>
        }

        <form method="post">
            <div class="form-group">
                <label asp-for="Username">Usuario</label>
                <input asp-for="Username" placeholder="Introduce tu usuario" />
            </div>

            <div class="form-group">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" type="password" placeholder="Introduce tu contraseña" />
            </div>

            <button type="submit" class="btn-login">
                Iniciar sesión
            </button>
        </form>

        <div class="divider">o</div>

        <a href="/ExternalLogin" class="btn-google">
            <svg width="18" height="18" viewBox="0 0 48 48">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Entrar con Google
        </a>

        <a href="/SteamLogin" class="btn-google" style="margin-top:10px;background:#1b2838;border-color:#1b2838;color:white">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path d="M12 0C5.37 0 0 5.37 0 12c0 5.43 3.61 10.01 8.57 11.47l3.07-6.35c-.22-.1-.43-.22-.62-.38A3.49 3.49 0 0 1 9.5 14a3.5 3.5 0 0 1 3.5-3.5c.97 0 1.84.4 2.48 1.03l6.06-2.95C20.17 3.78 16.4 0 12 0zm7.82 10.18l-6.06 2.95A3.48 3.48 0 0 1 13 14a3.5 3.5 0 0 1-3.5 3.5 3.49 3.49 0 0 1-1.22-.22L5.2 23.47C7.22 23.81 9.1 24 12 24c6.63 0 12-5.37 12-12 0-.65-.07-1.28-.18-1.82z"/>
            </svg>
            Entrar con Steam
        </a>

        <div class="footer">
            © @DateTime.Now.Year Server Panel
        </div>
    </div>

</body>
</html>
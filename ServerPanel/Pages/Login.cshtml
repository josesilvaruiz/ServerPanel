@page
@model ServerPanel.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Server Panel - Login</title>

    <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: "Segoe UI", sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: linear-gradient(135deg, #0f172a, #1e293b);
            }

            .login-card {
                width: 100%;
                max-width: 420px;
                background: white;
                padding: 40px;
                border-radius: 20px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.3);
            }

            .logo {
                text-align: center;
                margin-bottom: 30px;
            }

                .logo h1 {
                    color: #0f172a;
                    font-size: 2rem;
                }

                .logo p {
                    color: #64748b;
                    margin-top: 5px;
                }

            .form-group {
                margin-bottom: 18px;
            }

            label {
                display: block;
                margin-bottom: 8px;
                font-weight: 600;
                color: #334155;
            }

            input {
                width: 100%;
                padding: 14px;
                border: 1px solid #cbd5e1;
                border-radius: 10px;
                font-size: 15px;
                transition: all .2s;
            }

                input:focus {
                    outline: none;
                    border-color: #2563eb;
                    box-shadow: 0 0 0 3px rgba(37,99,235,.15);
                }

            .btn-login {
                width: 100%;
                border: none;
                background: #2563eb;
                color: white;
                padding: 14px;
                border-radius: 10px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: .2s;
            }

                .btn-login:hover {
                    background: #1d4ed8;
                    transform: translateY(-1px);
                }

            .error {
                margin-bottom: 15px;
                padding: 12px;
                background: #fee2e2;
                color: #b91c1c;
                border-radius: 10px;
                border: 1px solid #fecaca;
            }

            .footer {
                text-align: center;
                margin-top: 20px;
                color: #94a3b8;
                font-size: 13px;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo">
            <h1>Server Panel</h1>
            <p>Administración del servidor</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <div class="error">
                @Model.Error
            </div>
        }

        <form method="post" action="/Login?returnUrl=@Html.Raw(Uri.EscapeDataString(HttpContext.Request.Query["ReturnUrl"].ToString()))">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Username">Usuario</label>
                <input asp-for="Username" placeholder="Introduce tu usuario" />
            </div>

            <div class="form-group">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" type="password" placeholder="Introduce tu contraseña" />
            </div>

            <button type="submit" class="btn-login">
                Iniciar sesión
            </button>
        </form>

        <div class="footer">
            © @DateTime.Now.Year Server Panel
        </div>
    </div>

</body>
</html>